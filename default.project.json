{
  "name": "ColorChaos",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "ColorChaos": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "ColorChaosServer": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "ColorChaosClient": { "$path": "src/client" }
      }
    },
    "Workspace": {
      "$properties": { "Gravity": 140, "FallenPartsDestroyHeight": -60 },
      "ColorChaosWorld": { "$path": "scene/color-chaos-world.project.json" }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 14.4,
        "Brightness": 2.6,
        "GlobalShadows": true,
        "ExposureCompensation": 0.05,
        "EnvironmentDiffuseScale": 0.72,
        "EnvironmentSpecularScale": 0.65,
        "Ambient": [0.43, 0.49, 0.58],
        "OutdoorAmbient": [0.66, 0.71, 0.77]
      },
      "Atmosfera": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.17,
          "Offset": 0.25,
          "Color": [0.78, 0.88, 0.96],
          "Decay": [0.55, 0.64, 0.77],
          "Glare": 0.12,
          "Haze": 0.8
        }
      },
      "Neon": {
        "$className": "BloomEffect",
        "$properties": { "Intensity": 0.14, "Size": 20, "Threshold": 1.35 }
      },
      "Color": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Brightness": 0,
          "Contrast": 0.04,
          "Saturation": 0.06,
          "TintColor": [1, 0.99, 0.98]
        }
      }
    },
    "SoundService": { "$properties": { "RespectFilteringEnabled": true } }
  }
}
