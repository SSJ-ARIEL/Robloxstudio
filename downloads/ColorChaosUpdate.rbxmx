        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">Characters</string>
            <string name="Source"><![CDATA[-- Ciudad Prisma's original toy citizens. Catalog data is independent of Roblox services.
local Characters = {}
local palette = {
	{ 244, 86, 116 }, { 255, 164, 66 }, { 250, 214, 78 }, { 143, 216, 94 },
	{ 57, 202, 163 }, { 66, 192, 225 }, { 79, 141, 243 }, { 123, 107, 231 },
	{ 188, 115, 230 }, { 237, 119, 195 }, { 232, 141, 108 }, { 155, 195, 229 },
}
-- Family, Spanish label, complexion, variable region, ten original citizen names.
local families = {
	{ "robot", "Autómata", { 173, 192, 214 }, "Helmet", { "Núcleo", "Órbita", "Bisagra", "Tuerca", "Pulso", "Vector", "Bóveda", "Circuito", "Dínamo", "Módulo" } },
	{ "alien", "Visitante", { 149, 218, 198 }, "Coat", { "Nimbo", "Zeta", "Quásar", "Nova", "Cometa", "Púlsar", "Lumen", "Vega", "Cenit", "Cosmo" } },
	{ "fox", "Zorro", { 225, 144, 91 }, "Coat", { "Junco", "Bruma", "Cobre", "Duna", "Castaño", "Sendero", "Brezal", "Pinar", "Otoño", "Mirador" } },
	{ "cat", "Gato", { 195, 188, 214 }, "Coat", { "Tiza", "Nube", "Ópalo", "Miga", "Ovillo", "Trébol", "Bigote", "Lino", "Sombra", "Mosaico" } },
	{ "bear", "Oso", { 167, 128, 96 }, "Coat", { "Avellana", "Roble", "Tronco", "Miel", "Cedro", "Pardo", "Mora", "Bambú", "Musgo", "Bellota" } },
	{ "rabbit", "Conejo", { 230, 221, 213 }, "Coat", { "Algodón", "Salto", "Pétalo", "Nabo", "Trebolín", "Copito", "Zanahoria", "Mimbre", "Nardo", "Alfalfa" } },
	{ "frog", "Rana", { 119, 191, 138 }, "Coat", { "Juncal", "Charco", "Loto", "Rocío", "Nenúfar", "Estanque", "Gota", "Mangle", "Humedal", "Sauce" } },
	{ "owl", "Búho", { 159, 143, 126 }, "Coat", { "Farol", "Vigía", "Noche", "Pluma", "Sabio", "Lucero", "Bosque", "Cálamo", "Estrella", "Campana" } },
	{ "panda", "Panda", { 239, 233, 219 }, "Coat", { "Tallo", "Jade", "Brote", "Nébula", "Ladera", "Cumbre", "Tinta", "Calma", "Papiro", "Bambusal" } },
	{ "penguin", "Pingüino", { 70, 86, 110 }, "Coat", { "Fiordo", "Copo", "Témpano", "Aurora", "Viento", "Escarcha", "Glaciar", "Polo", "Nevado", "Boreal" } },
	{ "axolotl", "Ajolote", { 236, 188, 209 }, "Coat", { "Coral", "Burbuja", "Laguna", "Alga", "Perla", "Acuario", "Rizo", "Arrecife", "Concha", "Nácar" } },
	{ "shark", "Tiburón", { 128, 166, 193 }, "Coat", { "Marea", "Oleaje", "Abisal", "Aleta", "Cresta", "Espuma", "Bahía", "Faro", "Cala", "Atolón" } },
	{ "dragon", "Dragón", { 167, 183, 132 }, "Coat", { "Ascua", "Pedernal", "Ventisca", "Cripta", "Chispa", "Basalto", "Crisol", "Escama", "Cuarzo", "Bramido" } },
	{ "golem", "Gólem", { 168, 172, 165 }, "Coat", { "Granito", "Mármol", "Estrato", "Cantera", "Guijarro", "Runa", "Sílex", "Pizarra", "Cristal", "Cimiento" } },
	{ "mushroom", "Micelio", { 237, 217, 185 }, "Helmet", { "Espora", "Sotobosque", "Sombrilla", "Llovizna", "Honguito", "Helecho", "Madera", "Tierra", "Hojarasca", "Amanecer" } },
	{ "astronaut", "Astronauta", { 192, 147, 120 }, "Coat", { "Horizonte", "Gravedad", "Satélite", "Cráter", "Apogeo", "Galaxia", "Eclipse", "Tránsito", "Aster", "Zenit" } },
	{ "knight", "Guardián", { 213, 175, 139 }, "Helmet", { "Escudo", "Almena", "Baluarte", "Lanza", "Fortín", "Emblema", "Bastión", "Torre", "Justa", "Acero" } },
	{ "wizard", "Mago", { 179, 136, 113 }, "Coat", { "Sortilegio", "Pergamino", "Oráculo", "Arcano", "Sigilo", "Amuleto", "Espejo", "Astrolabio", "Runario", "Destello" } },
	{ "chef", "Chef", { 224, 174, 133 }, "Coat", { "Canela", "Tomillo", "Vainilla", "Azafrán", "Pimienta", "Romero", "Cacao", "Comino", "Laurel", "Jengibre" } },
	{ "diver", "Buzo", { 169, 121, 100 }, "Helmet", { "Profundo", "Inmersión", "Nautilo", "Sonda", "Muelle", "Boya", "Bajamar", "Estela", "Salitre", "Exploración" } },
	{ "racer", "Piloto", { 214, 162, 129 }, "Helmet", { "Turbo", "Chicane", "Apex", "Sprint", "Curva", "Ráfaga", "Vértice", "Circuito", "Impulso", "Bandera" } },
	{ "gardener", "Jardinero", { 197, 143, 111 }, "Coat", { "Semilla", "Huerto", "Surco", "Cosecha", "Flor", "Solana", "Raíz", "Abono", "Savia", "Regadera" } },
	{ "inventor", "Inventor", { 220, 183, 153 }, "Coat", { "Engranaje", "Resorte", "Plano", "Bobina", "Palanca", "Probeta", "Telescopio", "Turbina", "Imán", "Fuelle" } },
	{ "pirate", "Navegante", { 181, 134, 105 }, "Coat", { "Velero", "Timón", "Brújula", "Ancla", "Bitácora", "Barlovento", "Islote", "Cabo", "Bergantín", "Sextante" } },
	{ "explorer", "Explorador", { 237, 189, 154 }, "Coat", { "Mapa", "Cañón", "Senda", "Liana", "Derrumbe", "Campamento", "Cordillera", "Travesía", "Expedición", "Oasis" } },
}
local function frozen(value)
	if type(value) == "table" then
		for _, child in pairs(value) do frozen(child) end
		if not table.isfrozen(value) then table.freeze(value) end
	end
	return value
end
Characters.All = {}
for familyIndex, family in ipairs(families) do
	for variant = 1, 10 do
		local id = (familyIndex - 1) * 10 + variant
		local hue = ((familyIndex * 5 + variant * 7 - 1) % #palette) + 1
		local shift = ((variant - 1) % 5 - 2) * 5
		local target = table.clone(palette[hue])
		Characters.All[id] = frozen({
			Id = id, Name = family[2] .. " " .. family[5][variant], Family = family[2], Archetype = family[1],
			Variant = variant, Hue = hue, TargetPart = family[4], TargetRGB = target, ColorRGB = target,
			ColorArea = if family[4] == "Helmet" then (if family[1] == "mushroom" then "Sombrero" else "Casco") else "Chaqueta",
			SkinRGB = { math.clamp(family[3][1] + shift, 0, 255), math.clamp(family[3][2] + shift, 0, 255), math.clamp(family[3][3] + shift, 0, 255) },
			AccentRGB = table.clone(palette[((hue + 4) % #palette) + 1]),
			EyeStyle = (variant - 1) % 5 + 1, OutfitStyle = (variant - 1) % 5 + 1,
			PoseStyle = (variant - 1) % 4 + 1, BodyStyle = (variant - 1) % 3 + 1,
		})
	end
end
frozen(Characters.All)
Characters.Palette = frozen(palette)
Characters.ArchetypeCount = #families
function Characters.get(id)
	if type(id) ~= "number" or id ~= id or id % 1 ~= 0 then return nil end
	return Characters.All[id]
end
function Characters.all() return Characters.All end
function Characters.count() return #Characters.All end
return table.freeze(Characters)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">Config</string>
            <string name="Source"><![CDATA[-- Configuration shared by the authoritative server and presentation client.
local Config = {}
Config.Version = "1.1.0"
Config.MaxCoins = 100000000
Config.MaxReceipts = 10000 -- stop NEW sales before receipt history approaches datastore limits
Config.XPPerRound = 15
Config.XPPerWin = 25
Config.DailyMissions = {
	{ Key = "play3", Name = "Colabora en 3 rondas", Metric = "Rounds", Target = 3, Reward = 30 },
	{ Key = "repair8", Name = "Completa 8 acciones de reparación", Metric = "Actions", Target = 8, Reward = 40 },
	{ Key = "win2", Name = "Consigue 2 victorias", Metric = "Wins", Target = 2, Reward = 50 },
}

-- Replace these four zeros with IDs created for THIS experience in Creator Hub.
-- Prices are set in Roblox, retrieved locally and confirmed by the native prompt.
Config.Commerce = {
	Products = {
		{ Key = "coins100", ProductId = 0, Name = "100 monedas", Coins = 100, Description = "100 monedas para comprar auras de resultado conocido." },
		{ Key = "coins400", ProductId = 0, Name = "400 monedas", Coins = 400, Description = "400 monedas para comprar auras de resultado conocido." },
		{ Key = "coins1000", ProductId = 0, Name = "1000 monedas", Coins = 1000, Description = "1000 monedas para comprar auras de resultado conocido." },
	},
	VIP = { Key = "vip", PassId = 0, Name = "VIP Prisma", Description = "Aura Prisma exclusiva y título VIP. Sin ventajas en los desafíos." },
}

Config.Intermission = 16
Config.RoundSeconds = 100
Config.ResultSeconds = 9
Config.MinimumPlayers = 1
Config.MaxParticipants = 12
Config.DataStoreName = "ColorChaos_Player_v1"
Config.SaveInterval = 75
Config.WinCoins = 35
Config.ParticipationCoins = 10
Config.InteractionDistance = 13
Config.Lava = { StartHeight = 10, EndHeight = 31, MaxLift = 12, HalfWidth = 80, MinZ = -110, MaxZ = 66 }
Config.Colors = {
	{ Name = "AZUL", Symbol = "A", Color = Color3.fromRGB(55, 155, 255) },
	{ Name = "AMARILLO", Symbol = "B", Color = Color3.fromRGB(255, 214, 66) },
	{ Name = "VERDE", Symbol = "C", Color = Color3.fromRGB(79, 224, 145) },
	{ Name = "ROJO", Symbol = "D", Color = Color3.fromRGB(255, 96, 106) },
}
Config.Palettes = {
	{ Name = "CLÁSICA", Cost = 0, Color = Color3.fromRGB(55, 155, 255) },
	{ Name = "MENTA", Cost = 80, Color = Color3.fromRGB(79, 224, 145) },
	{ Name = "SOLAR", Cost = 150, Color = Color3.fromRGB(255, 214, 66) },
	{ Name = "ROSADA", Cost = 220, Color = Color3.fromRGB(255, 115, 205) },
	{ Name = "PRISMA VIP", Cost = 0, Access = "VIP", Color = Color3.fromRGB(203, 148, 255) },
	{ Name = "LAVANDA", Cost = 350, Color = Color3.fromRGB(190, 125, 255) },
	{ Name = "OCÉANO + ESTELA", Cost = 500, Trail = true, Color = Color3.fromRGB(55, 222, 245) },
	{ Name = "COMETA + ESTELA", Cost = 1000, Trail = true, Color = Color3.fromRGB(255, 160, 70) },
}
Config.Modes = {
	{ Id = "memory", Name = "PUENTES DE MEMORIA", Hint = "Mira la secuencia y activa sus letras en orden. Cada acierto crea un puente." },
	{ Id = "relay", Name = "REPARACIÓN EN EQUIPO", Hint = "Busca el color indicado y repara su estación. Todos comparten el objetivo." },
	{ Id = "rescue", Name = "RESCATE CROMÁTICO", Hint = "Activa el color indicado para crear un camino. Recoge su chispa y llévala al reactor." },
}

return Config
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Economy</string>
            <string name="Source"><![CDATA[-- Pure, server-owned progress. Randomness is injected by the server; gifts are
-- earned only. Purchased Coins cannot buy rolls or change the answer.
local Catalog = if script then require(script.Parent.Catalog) else require("./Catalog")
local Ledger = if script then require(script.Parent.ProfileLedger) else require("./ProfileLedger")
local Progression = if script then require(script.Parent.Progression) else require("./Progression")
local Economy = {}
local MAX_COINS, MAX_GEMS, MAX_COUNT, MAX_XP = 100000000, 10000000, 100000000, 99900
Economy.TimeGifts = table.freeze({
	table.freeze({ Key = "time2", Seconds = 120, Name = "20 diamantes", Kind = "Gems", Amount = 20 }),
	table.freeze({ Key = "time5", Seconds = 300, Name = "Traje Explorador Menta", Kind = "Suit", ItemId = "suit_mint" }),
	table.freeze({ Key = "time10", Seconds = 600, Name = "Emote Vuelta Estelar", Kind = "Emote", ItemId = "emote_spark" }),
	table.freeze({ Key = "time15", Seconds = 900, Name = "Reacción Corazón", Kind = "Reaction", ItemId = "reaction_heart" }),
	table.freeze({ Key = "time20", Seconds = 1200, Name = "Regalo gratuito", Kind = "FreeGifts", Amount = 1 }),
})
Economy.GiftOdds = table.freeze({
	table.freeze({ Kind = "Coins", Chance = 45, Amount = 50 }),
	table.freeze({ Kind = "Gems", Chance = 30, Amount = 15 }),
	table.freeze({ Kind = "Suit", Chance = 15 }),
	table.freeze({ Kind = "Emote", Chance = 6 }),
	table.freeze({ Kind = "Reaction", Chance = 4 }),
})

local function whole(value, cap)
	if type(value) ~= "number" or value ~= value or value < 0 or value == math.huge then return 0 end
	return math.min(math.floor(value), cap)
end
local function copy(value)
	if type(value) ~= "table" then return value end
	local result = {}; for key, child in pairs(value) do result[key] = copy(child) end; return result
end
local function day(now) return math.floor(whole(now, 100000000000) / 86400) end
local function coinCap(config)
	local configured = type(config) == "table" and whole(config.MaxCoins, MAX_COINS) or 0
	return configured > 0 and configured or MAX_COINS
end
local function addCoins(data, amount, config, reservedCoins)
	local received = math.min(amount, math.max(0, coinCap(config) - whole(reservedCoins, MAX_COINS) - data.Coins))
	data.Coins += received
	return received
end
local function addGems(data, amount)
	local received = math.min(amount, math.max(0, MAX_GEMS - data.Gems))
	data.Gems += received
	return received
end
local function refresh(data, now, config)
	if data.Timers.Day ~= day(now) then data.Timers = { Day = day(now), Seconds = 0, Claimed = {} } end
	data.Progress = Progression.clean(data.Progress, now, config)
end
local function addXP(data, amount) data.Progress.XP = math.min(MAX_XP, data.Progress.XP + amount) end
local function ownItem(data, id)
	local item = Catalog.ById[id]
	if data.CosmeticsOwned[id] then
		return { Kind = "Gems", Gems = addGems(data, 15), Amount = 15, ItemId = id, Name = item.Name, Duplicate = true }
	end
	data.CosmeticsOwned[id] = true
	return { Kind = item.Kind, ItemId = id, Name = item.Name, Duplicate = false }
end

function Economy.clean(raw, now, config)
	raw = type(raw) == "table" and raw or {}
	local owned = { ["1"] = true }
	-- Keep all former cosmetic entitlements, even when the new catalogue differs.
	for id, value in pairs(type(raw.Owned) == "table" and raw.Owned or {}) do
		if type(id) == "string" and #id <= 30 and value == true then owned[id] = true end
	end
	local selected = whole(raw.Selected, 100000)
	if selected < 1 then selected = 1 end
	local cosmetics, equipped = {}, {}
	for kind, id in pairs(Catalog.Defaults) do cosmetics[id], equipped[kind] = true, id end
	for id, value in pairs(type(raw.CosmeticsOwned) == "table" and raw.CosmeticsOwned or {}) do
		local item = Catalog.ById[id]
		if value == true and item and item.Access ~= "VIP" then cosmetics[id] = true end
	end
	for kind, id in pairs(type(raw.Equipped) == "table" and raw.Equipped or {}) do
		local item = type(id) == "string" and Catalog.ById[id] or nil
		if item and item.Kind == kind and (cosmetics[id] or item.Access == "VIP") then equipped[kind] = id end
	end
	local timer = type(raw.Timers) == "table" and raw.Timers or {}
	local timers = { Day = day(now), Seconds = 0, Claimed = {} }
	if timer.Day == timers.Day then
		timers.Seconds = whole(timer.Seconds, 86400)
		for _, gift in ipairs(Economy.TimeGifts) do
			if type(timer.Claimed) == "table" and timer.Claimed[gift.Key] == true then timers.Claimed[gift.Key] = true end
		end
	end
	local streak = whole(raw.CurrentStreak, MAX_COUNT)
	return {
		Coins = whole(raw.Coins, coinCap(config)), Gems = whole(raw.Gems, MAX_GEMS), Wins = whole(raw.Wins, MAX_COUNT),
		Selected = selected, Owned = owned, Receipts = Ledger.cleanReceipts(raw.Receipts),
		Progress = Progression.clean(raw.Progress, now, config), BestStreak = math.max(streak, whole(raw.BestStreak, MAX_COUNT)),
		CurrentStreak = streak, CorrectDoors = whole(raw.CorrectDoors, MAX_COUNT),
		CosmeticsOwned = cosmetics, Equipped = equipped, FreeGifts = whole(raw.FreeGifts, 1000000), Timers = timers,
	}
end

function Economy.correct(data, now, config, reservedCoins)
	refresh(data, now, config)
	local previous = data.CurrentStreak
	data.CurrentStreak = math.min(MAX_COUNT, previous + 1)
	data.BestStreak = math.max(data.BestStreak, data.CurrentStreak)
	data.CorrectDoors = math.min(MAX_COUNT, data.CorrectDoors + 1)
	data.Progress.Counts.Actions = math.min(1000000, data.Progress.Counts.Actions + 1)
	addXP(data, 10)
	local gifts = if data.CurrentStreak > previous and data.CurrentStreak % 5 == 0 and data.FreeGifts < 1000000 then 1 else 0
	data.FreeGifts += gifts
	return { Coins = addCoins(data, 8, config, reservedCoins), XP = 10, Streak = data.CurrentStreak, FreeGifts = gifts }
end

function Economy.fail(data) data.CurrentStreak = 0 end

function Economy.win(data, now, config, reservedCoins)
	refresh(data, now, config)
	data.Wins = math.min(MAX_COUNT, data.Wins + 1)
	data.Progress.Counts.Wins = math.min(1000000, data.Progress.Counts.Wins + 1)
	data.Progress.Counts.Rounds = math.min(1000000, data.Progress.Counts.Rounds + 1)
	addXP(data, 35)
	return { Coins = addCoins(data, 60, config, reservedCoins), Gems = addGems(data, 10), XP = 35, Wins = 1 }
end

function Economy.advanceTime(data, dt, now)
	if data.Timers.Day ~= day(now) then data.Timers = { Day = day(now), Seconds = 0, Claimed = {} } end
	if type(dt) ~= "number" or dt ~= dt or dt <= 0 or dt == math.huge then return 0 end
	local elapsed = math.min(dt, 5, 86400 - data.Timers.Seconds)
	data.Timers.Seconds += elapsed
	return elapsed
end

function Economy.claimTimeGift(data, key, now, config, reservedCoins)
	refresh(data, now, config)
	for _, gift in ipairs(Economy.TimeGifts) do
		if gift.Key == key then
			if data.Timers.Claimed[key] then return false, "Ya recogiste este regalo hoy." end
			if data.Timers.Seconds < gift.Seconds then return false, "Sigue jugando para desbloquear este regalo." end
			local reward
			if gift.ItemId then reward = ownItem(data, gift.ItemId)
			elseif gift.Kind == "Gems" then reward = { Kind = "Gems", Gems = addGems(data, gift.Amount), Amount = gift.Amount }
			elseif gift.Kind == "FreeGifts" then
				if data.FreeGifts >= 1000000 then return false, "Abre uno de tus regalos antes de recoger este." end
				data.FreeGifts += gift.Amount
				reward = { Kind = "FreeGifts", FreeGifts = gift.Amount, Amount = gift.Amount }
			end
			data.Timers.Claimed[key] = true
			return true, "Regalo recogido: " .. gift.Name .. ".", reward
		end
	end
	return false, "Regalo no disponible."
end

function Economy.openGift(data, roll, itemRoll, config, reservedCoins)
	if data.FreeGifts < 1 then return false, "Gana cinco aciertos seguidos para conseguir un regalo gratis." end
	if type(roll) ~= "number" or roll % 1 ~= 0 or roll < 1 or roll > 100 then return false, "No se pudo abrir el regalo." end
	local selected, boundary = nil, 0
	for _, chance in ipairs(Economy.GiftOdds) do
		boundary += chance.Chance
		if roll <= boundary then selected = chance; break end
	end
	local reward
	if selected.Kind == "Coins" then reward = { Kind = "Coins", Coins = addCoins(data, 50, config, reservedCoins), Amount = 50 }
	elseif selected.Kind == "Gems" then reward = { Kind = "Gems", Gems = addGems(data, 15), Amount = 15 }
	else
		local pool = Catalog.RewardPools[selected.Kind]
		if type(itemRoll) ~= "number" or itemRoll % 1 ~= 0 or itemRoll < 1 or itemRoll > #pool then return false, "No se pudo abrir el regalo." end
		reward = ownItem(data, pool[itemRoll])
	end
	data.FreeGifts -= 1
	local label = reward.Name or (reward.Amount .. (reward.Kind == "Coins" and " monedas" or " diamantes"))
	if reward.Duplicate then label = "15 diamantes por cosmético repetido" end
	return true, "Tu regalo: " .. label .. ".", reward
end

function Economy.purchase(data, id, vip)
	local item = type(id) == "string" and Catalog.ById[id] or nil
	if not item then return false, "Cosmético no disponible." end
	if item.Access == "VIP" then
		if vip ~= true then return false, "Este cosmético pertenece al pase VIP Prisma." end
	elseif not data.CosmeticsOwned[id] then
		if data[item.Currency] < item.Cost then return false, item.Currency == "Coins" and "Necesitas más monedas." or "Necesitas más diamantes. Puedes ganarlos jugando." end
		data[item.Currency] -= item.Cost
		data.CosmeticsOwned[id] = true
	end
	data.Equipped[item.Kind] = id
	return true, item.Name .. " equipado."
end

function Economy.equip(data, id, vip)
	local item = type(id) == "string" and Catalog.ById[id] or nil
	if not item then return false, "Cosmético no disponible." end
	if item.Access == "VIP" then
		if vip ~= true then return false, "Este cosmético pertenece al pase VIP Prisma." end
	elseif not data.CosmeticsOwned[id] then return false, "Todavía no tienes este cosmético." end
	data.Equipped[item.Kind] = id
	return true, item.Name .. " equipado."
end

function Economy.view(data, now)
	local timers = if data.Timers.Day == day(now) then data.Timers else { Seconds = 0, Claimed = {} }
	local gifts = {}
	for _, gift in ipairs(Economy.TimeGifts) do
		local row = copy(gift)
		row.Claimed = timers.Claimed[gift.Key] == true
		row.Ready = timers.Seconds >= gift.Seconds and not row.Claimed
		row.Remaining = math.max(0, math.ceil(gift.Seconds - timers.Seconds))
		table.insert(gifts, row)
	end
	return {
		Coins = data.Coins, Gems = data.Gems, Wins = data.Wins, XP = data.Progress.XP,
		Level = math.min(1000, math.floor(data.Progress.XP / 100) + 1), LevelProgress = data.Progress.XP % 100,
		BestStreak = data.BestStreak, CurrentStreak = data.CurrentStreak, Streak = data.CurrentStreak,
		CorrectDoors = data.CorrectDoors, FreeGifts = data.FreeGifts, CosmeticsOwned = copy(data.CosmeticsOwned),
		Equipped = copy(data.Equipped), Selected = data.Selected, Owned = copy(data.Owned),
		TimeGifts = gifts, PlaySeconds = math.floor(timers.Seconds), GiftOdds = copy(Economy.GiftOdds),
	}
end

return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">GameRules</string>
            <string name="Source"><![CDATA[-- Server-owned geometry and question rules. Pure data makes them independently testable.
local Characters = if script then require(script.Parent.Characters) else require("./Characters")
local GameRules = {}

local DEFAULT_LANES = { -40, -20, 0, 20, 40 }
local DISTRACTORS = Characters.Palette
local MINIMUM_COLOR_DISTANCE_SQUARED = 70 * 70

local function finite(value)
	return type(value) == "number" and value == value and math.abs(value) < math.huge
end

local function sameRGB(a, b)
	return a[1] == b[1] and a[2] == b[2] and a[3] == b[3]
end

local function distinctColor(a, b)
	local r, g, blue = a[1] - b[1], a[2] - b[2], a[3] - b[3]
	return r * r + g * g + blue * blue >= MINIMUM_COLOR_DISTANCE_SQUARED
end

local function copyRGB(rgb)
	assert(type(rgb) == "table", "Character must define a target RGB color")
	local copy = {}
	for index = 1, 3 do
		assert(finite(rgb[index]) and rgb[index] >= 0 and rgb[index] <= 255, "Invalid target RGB channel")
		copy[index] = math.floor(rgb[index])
	end
	return copy
end

function GameRules.stageCoordinates(index, _settings)
	assert(finite(index) and index >= 1 and index % 1 == 0, "Invalid stage number")
	local start = -40 - (index - 1) * 112
	return { StartZ = start, GateZ = start - 48, EndZ = start - 82 }
end

function GameRules.generateQuestion(character, random)
	assert(type(character) == "table" and character.Id ~= nil, "Missing character")
	assert(random and type(random.NextInteger) == "function", "Question requires server randomness")
	local original = copyRGB(character.ColorRGB or character.TargetRGB)
	local available = {}
	for _, color in ipairs(DISTRACTORS) do
		if distinctColor(color, original) then table.insert(available, table.clone(color)) end
	end
	-- Sampling without replacement prevents repeated alternatives, even for adversarial RNG mocks.
	local choices = { table.clone(original) }
	for _ = 1, 4 do
		assert(#available > 0, "Character palette lacks five clearly distinct alternatives")
		local choice = table.remove(available, random:NextInteger(1, #available))
		table.insert(choices, choice)
		for index = #available, 1, -1 do
			if not distinctColor(available[index], choice) then table.remove(available, index) end
		end
	end
	for index = #choices, 2, -1 do
		local other = random:NextInteger(1, index)
		choices[index], choices[other] = choices[other], choices[index]
	end
	local correct, wrongOptions = nil, {}
	for index, color in ipairs(choices) do
		if sameRGB(color, original) then correct = index else table.insert(wrongOptions, color) end
	end
	return {
		CharacterId = character.Id, Choices = choices, CorrectLane = correct,
		WrongRGB = table.clone(wrongOptions[random:NextInteger(1, #wrongOptions)]),
		OriginalRGB = original,
	}
end

function GameRules.validChoice(position, stage, elapsed, settings)
	settings = settings or {}
	local minimum = settings.MinimumChoiceSeconds or 1.5
	if not finite(elapsed) or elapsed < minimum or position == nil then return nil end
	local x, y, z = position.X or position.x, position.Y or position.y, position.Z or position.z
	if not finite(x) or not finite(y) or not finite(z) then return nil end
	local coordinates = type(stage) == "number" and GameRules.stageCoordinates(stage) or stage
	if type(coordinates) ~= "table" or not finite(coordinates.GateZ) then return nil end
	if y < 7 or y > 20 or z < coordinates.GateZ + 4 or z > coordinates.GateZ + 16 then return nil end
	for lane, laneX in ipairs(settings.LaneX or DEFAULT_LANES) do
		if math.abs(x - laneX) <= 8 then return lane end
	end
	return nil
end

function GameRules.rankRoom(entries)
	local rows = {}
	for _, entry in pairs(entries) do
		if type(entry) == "table" and entry.Eligible ~= false and not entry.Ghost
			and finite(entry.UserId) and entry.UserId > 0 and entry.UserId % 1 == 0 then
			local row = table.clone(entry)
			row.CorrectThisMatch = finite(row.CorrectThisMatch) and math.max(0, math.floor(row.CorrectThisMatch)) or 0
			row.LastChoiceAt = finite(row.LastChoiceAt) and row.LastChoiceAt or math.huge
			table.insert(rows, row)
		end
	end
	table.sort(rows, function(a, b)
		if a.CorrectThisMatch ~= b.CorrectThisMatch then return a.CorrectThisMatch > b.CorrectThisMatch end
		if a.LastChoiceAt ~= b.LastChoiceAt then return a.LastChoiceAt < b.LastChoiceAt end
		return a.UserId < b.UserId
	end)
	for position, row in ipairs(rows) do row.Place = position end
	return rows
end

return table.freeze(GameRules)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">GameSettings</string>
            <string name="Source"><![CDATA[-- New gameplay settings live separately so upgrades retain the owner's Config.
return table.freeze({
	Version = "2.0.0",
	Title = "Color Chaos: Ciudad Prisma",
	MinimumPlayers = 1,
	MaxParticipants = 20,
	Intermission = 18,
	PreviewSeconds = 2,
	RunSeconds = 12,
	MinimumChoiceSeconds = 1.5,
	FinalSeconds = 15,
	RevealSeconds = 2,
	TravelSeconds = 6,
	ResultSeconds = 8,
	Stages = 8,
	FinalMinStage = 3,
	SaveInterval = 60,
	LeaderboardInterval = 90,
	LobbyPosition = table.freeze({ 0, 11, 110 }),
	LaneX = table.freeze({ -40, -20, 0, 20, 40 }),
	StartZ = -40,
	StageSpacing = 112,
	GateOffset = -48,
	EndOffset = -82,
	AvatarY = 10,
	ChoiceMinY = 7,
	ChoiceMaxY = 20,
	CorrectCoins = 8,
	CorrectXP = 10,
	WinCoins = 60,
	WinGems = 10,
	WinXP = 35,
	GiftEveryStreak = 5,
})
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Portrait</string>
            <string name="Source"><![CDATA[-- Original rounded toy sculptures. Alternatives share geometry, pose, lens and lighting.
local Characters = require(script.Parent.Characters)
local Portrait = {}
local IVORY = Color3.fromRGB(248, 243, 227)
local INK = Color3.fromRGB(37, 46, 68)
local GOLD = Color3.fromRGB(246, 210, 133)
local GRAY = Color3.fromRGB(139, 150, 169)
local function rgb(value) return Color3.fromRGB(value[1], value[2], value[3]) end
local function resolve(character)
	local id = if type(character) == "table" then character.Id else character
	return assert(Characters.get(id), "Unknown Ciudad Prisma character")
end

function Portrait.build(input, overrideRGB, hideTarget)
	local citizen = resolve(input)
	local model = Instance.new("Model")
	model.Name = "Portrait_" .. citizen.Id
	model:SetAttribute("CharacterId", citizen.Id)
	model:SetAttribute("CharacterName", citizen.Name)
	local skin, accent = rgb(citizen.SkinRGB), rgb(citizen.AccentRGB)
	local target = if hideTarget then GRAY else rgb(overrideRGB or citizen.ColorRGB)
	local coatTarget, helmetTarget = citizen.TargetPart == "Coat", citizen.TargetPart == "Helmet"
	local coat, helmet = if coatTarget then target else accent, if helmetTarget then target else accent
	local family, variant = citizen.Archetype, citizen.Variant
	local width = ({ 1.65, 1.83, 1.73 })[citizen.BodyStyle]
	local function piece(name, x, y, z, sx, sy, sz, color, shape, rotation, isTarget)
		local part = Instance.new(if shape == "Wedge" then "WedgePart" else "Part")
		part.Name = name
		part.Size = Vector3.new(sx, sy, sz)
		part.CFrame = CFrame.new(x, y, z) * (rotation or CFrame.identity)
		part.Color, part.Material = color, Enum.Material.SmoothPlastic
		part.Anchored, part.CanCollide, part.CanTouch, part.CanQuery = true, false, false, false
		part.CastShadow = false
		part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		if shape == "Ball" then part.Shape = Enum.PartType.Ball end
		if shape == "Cylinder" then part.Shape = Enum.PartType.Cylinder end
		part:SetAttribute("ColorTarget", isTarget == true)
		part.Parent = model
		return part
	end
	local function ball(name, x, y, z, sx, sy, sz, color, rotation, isTarget)
		return piece(name, x, y, z, sx, sy, sz, color, "Ball", rotation, isTarget)
	end
	local function box(name, x, y, z, sx, sy, sz, color, rotation, isTarget)
		return piece(name, x, y, z, sx, sy, sz, color, nil, rotation, isTarget)
	end
	local function wedge(name, x, y, z, sx, sy, sz, color, rotation)
		return piece(name, x, y, z, sx, sy, sz, color, "Wedge", rotation)
	end
	local function disk(name, x, y, z, diameter, depth, color)
		return piece(name, x, y, z, depth, diameter, diameter, color, "Cylinder", CFrame.Angles(0, math.pi / 2, 0))
	end
	local tilt = math.rad(({ 10, -8, 18, -14 })[citizen.PoseStyle])
	for _, side in ipairs({ -1, 1 }) do
		ball("ShoeSole", side * 0.43, 0.27, 0.20, 0.74, 0.19, 0.98, IVORY)
		ball("Shoe", side * 0.43, 0.45, 0.14, 0.70, 0.47, 0.94, INK)
		box("ShoeStripe", side * 0.43, 0.44, 0.59, 0.39, 0.075, 0.035, accent)
		ball("Trouser", side * 0.42, 0.98, 0, 0.57, 1.04, 0.68, INK)
		ball("Sleeve", side * (width / 2 + 0.18), 2.17, 0, 0.62, 1.29, 0.72, coat, CFrame.Angles(0, 0, side * tilt), coatTarget)
		ball("Cuff", side * (width / 2 + 0.25), 1.64, 0.09, 0.57, 0.21, 0.68, IVORY)
		ball("Hand", side * (width / 2 + 0.28), 1.45, 0.16, 0.52, 0.49, 0.54, skin)
		ball("Thumb", side * (width / 2 + 0.05), 1.51, 0.32, 0.21, 0.26, 0.25, skin)
	end
	ball("TargetJacket", 0, 2.07, 0, width, 1.82, 1.12, coat, nil, coatTarget)
	ball("JacketHem", 0, 1.40, 0.02, width * 0.94, 0.27, 1.02, INK)
	ball("Collar", 0, 2.88, 0, 0.98, 0.31, 1.04, IVORY)
	box("Zipper", 0, 2.06, 0.563, 0.055, 1.18, 0.028, INK)
	disk("ZipperPull", 0.005, 2.59, 0.594, 0.10, 0.035, GOLD)
	disk("PrismaBadge", -0.49, 2.43, 0.50, 0.27, 0.055, IVORY)
	wedge("BadgePrism", -0.49, 2.43, 0.535, 0.14, 0.17, 0.04, accent)
	if citizen.OutfitStyle == 1 then
		for _, side in ipairs({ -1, 1 }) do
			ball("Pocket", side * 0.48, 1.87, 0.48, 0.46, 0.36, 0.19, accent)
			box("PocketStitch", side * 0.48, 1.94, 0.57, 0.29, 0.025, 0.025, IVORY)
		end
	elseif citizen.OutfitStyle == 2 then
		box("Sash", 0.17, 2.13, 0.56, 0.18, 1.32, 0.055, accent, CFrame.Angles(0, 0, 0.40))
	elseif citizen.OutfitStyle == 3 then
		for _, side in ipairs({ -1, 1 }) do ball("ShoulderTrim", side * 0.76, 2.65, 0.10, 0.56, 0.19, 0.73, accent) end
	elseif citizen.OutfitStyle == 4 then
		for _, side in ipairs({ -1, 1 }) do box("Harness", side * 0.34, 2.14, 0.55, 0.12, 1.12, 0.05, accent) end
		disk("Clasp", 0, 2.16, 0.60, 0.23, 0.045, GOLD)
	else
		ball("Scarf", 0, 2.84, 0.30, 1.00, 0.25, 0.65, accent)
		box("ScarfTail", 0.45, 2.43, 0.57, 0.25, 0.69, 0.075, accent, CFrame.Angles(0, 0, -0.12))
	end
	local headWidth = if family == "alien" or family == "frog" then 2.15 else 1.94
	local robot = family == "robot"
	local headColor = if robot then helmet else skin
	if robot or family == "golem" then
		box("Head", 0, 3.86, 0, headWidth * 0.90, 1.51, 1.40, headColor, nil, robot)
		ball("HeadCrown", 0, 4.51, -0.02, headWidth * 0.91, 0.30, 1.39, headColor, nil, robot)
	else
		ball("Head", 0, 3.87, 0, headWidth, 1.83, 1.58, skin)
	end
	local faceZ = 0.76
	if robot then
		ball("FaceScreen", 0, 3.89, 0.74, 1.57, 1.10, 0.14, INK)
		for _, side in ipairs({ -1, 1 }) do ball("EarSpeaker", side * 0.96, 3.88, 0, 0.31, 0.65, 0.74, GOLD) end
	elseif family == "penguin" then
		ball("FaceMask", 0, 3.78, 0.61, 1.63, 1.35, 0.38, IVORY)
		ball("Belly", 0, 1.97, 0.55, 0.82, 1.03, 0.13, IVORY)
	elseif family == "panda" then
		for _, side in ipairs({ -1, 1 }) do ball("EyePatch", side * 0.40, 4.02, 0.72, 0.68, 0.75, 0.20, INK, CFrame.Angles(0, 0, side * 0.20)) end
	elseif family == "owl" then
		for _, side in ipairs({ -1, 1 }) do ball("FacialDisc", side * 0.41, 3.98, 0.65, 0.93, 1.07, 0.30, GOLD) end
	end
	local eyeY = if family == "frog" then 4.23 else 4.04
	for _, side in ipairs({ -1, 1 }) do
		local x = side * (if family == "alien" then 0.47 else 0.39)
		if family == "frog" then ball("EyeSocket", x, eyeY, 0.59, 0.78, 0.85, 0.56, skin) end
		if citizen.EyeStyle == 4 then
			box("JoyEye", x, eyeY, faceZ + 0.08, 0.32, 0.075, 0.07, if robot then IVORY else INK, CFrame.Angles(0, 0, side * 0.15))
		else
			ball("EyeWhite", x, eyeY, faceZ, 0.40, if citizen.EyeStyle == 3 then 0.48 else 0.41, 0.16, IVORY)
			ball("Iris", x + (if citizen.EyeStyle == 5 then 0.025 else 0), eyeY, faceZ + 0.081, 0.235, 0.29, 0.075, INK)
			ball("EyeLight", x - 0.047, eyeY + 0.071, faceZ + 0.122, 0.085, 0.085, 0.024, IVORY)
		end
		box("Brow", x, eyeY + 0.31, faceZ - 0.025, 0.35, 0.065, 0.07, INK, CFrame.Angles(0, 0, side * (0.05 + citizen.EyeStyle * 0.025)))
		if not robot then ball("Cheek", side * 0.62, 3.69, 0.66, 0.28, 0.14, 0.045, skin:Lerp(Color3.fromRGB(241, 146, 151), 0.45)) end
	end
	local muzzle = ({ fox = true, cat = true, bear = true, panda = true, shark = true })[family]
	if muzzle then ball("Muzzle", 0, 3.61, 0.70, 0.88, 0.51, 0.38, IVORY) end
	ball("Nose", 0, 3.78, if muzzle then 0.91 else 0.78, 0.20, 0.145, 0.13, if robot then GOLD else INK)
	ball("Smile", 0, 3.51, if muzzle then 0.88 else 0.73, 0.32, 0.075, 0.055, INK)
	for _, side in ipairs({ -1, 1 }) do
		if family == "fox" or family == "cat" then
			local h = if family == "fox" then 1.04 else 0.72
			wedge("Ear", side * 0.72, 4.70, -0.02, 0.67, h, 0.65, skin, CFrame.Angles(0, 0, -side * 0.12))
			wedge("InnerEar", side * 0.72, 4.70, 0.31, 0.36, h * 0.65, 0.04, accent)
			for line = 1, 2 do box("Whisker", side * 0.67, 3.64 - line * 0.09, 0.70, 0.37, 0.026, 0.035, INK, CFrame.Angles(0, 0, side * line * 0.10)) end
		elseif family == "bear" or family == "panda" then
			ball("Ear", side * 0.80, 4.58, 0, 0.73, 0.74, 0.48, if family == "panda" then INK else skin)
			ball("InnerEar", side * 0.80, 4.58, 0.23, 0.37, 0.37, 0.06, accent)
		elseif family == "rabbit" then
			local angle = CFrame.Angles(0, 0, side * (0.08 + variant * 0.018))
			ball("Ear", side * 0.49, 5.10, -0.11, 0.45, 1.70, 0.45, skin, angle)
			ball("InnerEar", side * 0.49, 5.14, 0.10, 0.21, 1.17, 0.05, accent, angle)
		elseif family == "owl" then
			wedge("EarTuft", side * 0.75, 4.61, -0.10, 0.62, 0.66, 0.61, skin)
		elseif family == "axolotl" then
			for branch = 1, 3 do
				local angle = CFrame.Angles(0, 0, side * math.rad((branch - 2) * 35))
				ball("Gill", side * (1.05 + branch * 0.05), 3.54 + branch * 0.25, 0, 0.86, 0.19, 0.32, accent, angle)
				ball("GillTip", side * (1.41 + branch * 0.05), 3.54 + branch * 0.25, 0, 0.20, 0.28, 0.30, skin:Lerp(accent, 0.65), angle)
			end
		elseif family == "dragon" then
			wedge("Horn", side * 0.62, 4.71, -0.14, 0.35, 0.85, 0.43, GOLD, CFrame.Angles(0, 0, side * 0.20))
			wedge("Wing", side * 1.28, 2.45, -0.40, 1.13, 1.69, 0.15, accent, CFrame.Angles(0, 0, side * 0.31))
		elseif family == "golem" then
			box("StoneBrow", side * 0.42, 4.37, 0.72, 0.67, 0.20, 0.23, skin, CFrame.Angles(0, 0, side * 0.11))
			wedge("ShoulderCrystal", side * 0.95, 2.90, 0, 0.51, 0.78, 0.49, accent)
		end
	end
	if family == "owl" or family == "penguin" then
		wedge("Beak", 0, 3.70, 0.91, 0.40, 0.34, 0.43, GOLD, CFrame.Angles(math.pi, 0, 0))
	elseif family == "alien" then
		for _, side in ipairs({ -1, 1 }) do
			box("Antenna", side * 0.59, 4.78, 0, 0.075, 0.55 + variant * 0.016, 0.075, skin, CFrame.Angles(0, 0, side * 0.25))
			ball("AntennaTip", side * 0.67, 5.08 + variant * 0.008, 0, 0.28, 0.28, 0.28, accent)
		end
	elseif family == "shark" then
		wedge("DorsalFin", 0, 4.73, -0.26, 0.38, 1.01, 0.85, skin)
		for tooth = -1, 1 do wedge("Tooth", tooth * 0.15, 3.49, 0.92, 0.11, 0.15, 0.035, IVORY, CFrame.Angles(0, 0, math.pi)) end
	elseif family == "mushroom" then
		ball("TargetCap", 0, 4.65, -0.07, 2.83, 1.17, 2.03, helmet, nil, true)
		ball("CapRim", 0, 4.26, -0.07, 2.76, 0.18, 1.95, IVORY)
		for spot = -2, 2 do ball("CapSpot", spot * 0.42, 4.77 + (2 - math.abs(spot)) * 0.10, 0.72, 0.26, 0.18, 0.09, IVORY) end
	elseif family == "astronaut" then
		-- Open visor: the citizen's face stays visible instead of being buried by a sphere.
		ball("HelmetBack", 0, 3.97, -0.34, 2.20, 2.10, 1.45, IVORY)
		for _, side in ipairs({ -1, 1 }) do ball("HelmetRim", side * 0.99, 3.88, 0.32, 0.20, 1.60, 0.59, IVORY) end
		box("ChestConsole", 0, 2.07, 0.59, 0.69, 0.44, 0.12, IVORY)
		for lamp = -1, 1 do disk("ConsoleLight", lamp * 0.19, 2.08, 0.66, 0.10, 0.03, accent) end
	elseif family == "knight" then
		ball("TargetHelmet", 0, 3.94, -0.08, 2.11, 2.01, 1.72, helmet, nil, true)
		ball("Visor", 0, 4.02, 0.80, 1.55, 0.46, 0.10, INK)
		box("NoseGuard", 0, 3.90, 0.87, 0.16, 0.76, 0.09, helmet, nil, true)
		ball("Plume", 0, 5.00, -0.14, 0.45, 0.65 + variant * 0.015, 0.91, accent)
	elseif family == "wizard" then
		ball("HatBrim", 0, 4.58, 0, 2.45, 0.19, 1.87, accent)
		wedge("HatCrown", 0, 5.13, -0.13, 1.31, 1.14, 1.12, accent, CFrame.Angles(0, 0, math.rad((variant - 5) * 2)))
		disk("HatRune", 0, 5.00, 0.45, 0.28, 0.04, GOLD)
	elseif family == "chef" then
		box("HatBand", 0, 4.63, 0, 1.84, 0.29, 1.35, IVORY)
		for cloud = -1, 1 do ball("Toque", cloud * 0.51, 5.04 + (if cloud == 0 then 0.17 else 0), 0, 1.01, 0.84, 1.31, IVORY) end
		ball("Apron", 0, 1.83, 0.56, 0.88, 0.81, 0.11, IVORY)
	elseif family == "diver" then
		ball("TargetDiveHelmet", 0, 3.95, -0.06, 2.23, 2.12, 1.81, helmet, nil, true)
		disk("WindowRing", 0, 3.97, 0.88, 1.34, 0.10, GOLD)
		disk("Window", 0, 3.97, 0.945, 1.11, 0.04, INK)
		box("WindowGleam", -0.23, 4.18, 0.975, 0.24, 0.05, 0.02, IVORY, CFrame.Angles(0, 0, 0.28))
	elseif family == "racer" then
		ball("TargetRaceHelmet", 0, 3.96, -0.06, 2.10, 1.98, 1.69, helmet, nil, true)
		ball("Visor", 0, 4.05, 0.81, 1.66, 0.78, 0.12, INK)
		box("VisorGleam", -0.36, 4.21, 0.875, 0.47, 0.05, 0.02, IVORY, CFrame.Angles(0, 0, 0.11))
	elseif family == "gardener" then
		ball("SunhatBrim", 0, 4.59, 0, 2.58, 0.22, 1.99, GOLD)
		ball("SunhatCrown", 0, 4.85, -0.07, 1.76, 0.70, 1.44, GOLD)
		ball("HatFlower", 0.73, 4.70, 0.48, 0.32, 0.32, 0.12, accent)
	elseif family == "explorer" then
		ball("SafariBrim", 0, 4.60, 0.06, 2.23, 0.20, 1.76, GOLD)
		ball("SafariCrown", 0, 4.88, -0.07, 1.64, 0.83, 1.49, GOLD)
		box("SafariRidge", 0, 5.10, 0.05, 0.15, 0.22, 1.24, IVORY)
		disk("Compass", 0.49, 2.55, 0.57, 0.33, 0.07, INK)
	elseif family == "inventor" then
		for _, side in ipairs({ -1, 1 }) do
			disk("GoggleRim", side * 0.39, 4.10, 0.85, 0.61, 0.07, GOLD)
			disk("GoggleGlass", side * 0.39, 4.10, 0.90, 0.43, 0.04, INK)
			ball("GoggleGleam", side * 0.39 - 0.07, 4.19, 0.93, 0.12, 0.06, 0.015, IVORY)
		end
		box("GoggleBridge", 0, 4.10, 0.89, 0.19, 0.07, 0.05, GOLD)
	elseif family == "pirate" then
		ball("HatBrim", 0, 4.59, -0.07, 2.57, 0.25, 1.87, INK)
		wedge("Tricorn", 0, 4.94, -0.16, 2.04, 0.71, 1.13, INK)
		disk("CompassEmblem", 0, 4.86, 0.48, 0.30, 0.04, GOLD)
	end
	-- All ten variants alter their silhouette or accessories, even with color removed.
	if variant == 1 then
		ball("Ribbon", 0.99, 4.16, 0.23, 0.48, 0.19, 0.23, accent, CFrame.Angles(0, 0, 0.30))
	elseif variant == 2 then
		box("Comms", -1.02, 3.90, 0.23, 0.23, 0.57, 0.39, GOLD)
		box("Mic", -0.74, 3.50, 0.78, 0.39, 0.07, 0.07, INK)
	elseif variant == 3 then
		for _, side in ipairs({ -1, 1 }) do ball("Mantle", side * 0.97, 2.85, -0.13, 0.62, 0.28, 0.78, GOLD) end
	elseif variant == 4 then
		box("Notebook", -1.05, 1.50, 0.52, 0.50, 0.70, 0.16, accent, CFrame.Angles(0, 0, -0.15))
		box("BookSpine", -1.26, 1.50, 0.60, 0.07, 0.70, 0.04, GOLD)
	elseif variant == 5 then
		ball("Charm", 0.47, 2.58, 0.59, 0.29, 0.32, 0.08, GOLD)
		for _, side in ipairs({ -1, 1 }) do ball("WristRing", side * (width / 2 + 0.28), 1.52, 0.16, 0.55, 0.12, 0.58, GOLD) end
	elseif variant == 6 then
		box("SatchelStrap", -0.50, 2.05, 0.59, 0.15, 1.40, 0.04, GOLD, CFrame.Angles(0, 0, -0.24))
		ball("Satchel", -0.80, 1.48, 0.55, 0.70, 0.60, 0.33, accent)
	elseif variant == 7 then
		ball("Brooch", 0.48, 2.65, 0.56, 0.43, 0.34, 0.11, IVORY)
		ball("BroochCore", 0.48, 2.65, 0.62, 0.20, 0.20, 0.04, accent)
	elseif variant == 8 then
		box("FlagPole", 1.26, 2.46, -0.33, 0.055, 2.89, 0.055, GOLD)
		wedge("Pennant", 1.51, 3.73, -0.33, 0.55, 0.70, 0.08, accent)
	elseif variant == 9 then
		ball("Gadget", 1.04, 1.49, 0.48, 0.55, 0.54, 0.27, INK)
		disk("GadgetDial", 1.04, 1.49, 0.63, 0.28, 0.04, GOLD)
	else
		box("Cape", 0, 2.13, -0.67, 1.70, 1.87, 0.11, accent)
		for _, side in ipairs({ -1, 1 }) do ball("CapeClasp", side * 0.58, 2.75, 0.49, 0.24, 0.23, 0.13, GOLD) end
	end
	return model
end

function Portrait.mount(viewport, input, overrideRGB, options)
	local citizen = resolve(input)
	local hideTarget = options == true or (type(options) == "table" and options.HideTarget == true)
	local previous = viewport:FindFirstChild("PortraitWorld")
	if previous then previous:Destroy() end
	local previousCamera = viewport:FindFirstChild("PortraitCamera")
	if previousCamera then previousCamera:Destroy() end
	local world = Instance.new("WorldModel")
	world.Name, world.Parent = "PortraitWorld", viewport
	local model = Portrait.build(citizen, overrideRGB, hideTarget)
	model.Parent = world
	local camera = Instance.new("Camera")
	camera.Name, camera.FieldOfView = "PortraitCamera", 34
	local bust = type(options) == "table" and options.Framing == "bust"
	camera.CFrame = if bust then CFrame.lookAt(Vector3.new(0, 3.9, 9.2), Vector3.new(0, 3.65, 0)) else CFrame.lookAt(Vector3.new(0, 3.25, 11.8), Vector3.new(0, 3.10, 0))
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	viewport.Ambient = Color3.fromRGB(188, 198, 215)
	viewport.LightColor = Color3.fromRGB(255, 246, 224)
	viewport.LightDirection = Vector3.new(-0.45, -0.75, -1)
	return model
end

return table.freeze(Portrait)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">ProfileLedger</string>
            <string name="Source"><![CDATA[-- Paid grants and their receipt IDs live in the SAME atomic profile update.
-- Merge protects receipts even if a committed UpdateAsync loses its response.
local Ledger = {}

local function copy(value)
	if type(value) ~= "table" then return value end
	local result = {}
	for key, child in pairs(value) do result[key] = copy(child) end
	return result
end

function Ledger.cleanReceipts(raw)
	local result = {}
	if type(raw) ~= "table" then return result end
	for id, amount in pairs(raw) do
		if type(id) == "string" and #id > 0 and #id <= 200 and type(amount) == "number"
			and amount == amount and amount > 0 and amount < math.huge and amount % 1 == 0 then
			result[id] = amount
		end
	end
	return result
end

function Ledger.merge(base, persisted, maxCoins)
	local result = copy(base)
	result.Receipts = Ledger.cleanReceipts(base.Receipts)
	for id, amount in pairs(Ledger.cleanReceipts(type(persisted) == "table" and persisted.Receipts or nil)) do
		if result.Receipts[id] == nil then
			result.Coins += amount
			result.Receipts[id] = amount
		end
		-- The durable record is authoritative even if local metadata is damaged.
		result.Receipts[id] = amount
	end
	if result.Coins > maxCoins then return nil end
	return result
end

function Ledger.grant(base, persisted, receiptId, amount, maxCoins)
	if type(receiptId) ~= "string" or #receiptId == 0 or #receiptId > 200 then return nil end
	if type(amount) ~= "number" or amount ~= amount or amount <= 0 or amount == math.huge or amount % 1 ~= 0 then return nil end
	local result = Ledger.merge(base, persisted, maxCoins)
	if not result then return nil end
	local receipts = Ledger.cleanReceipts(type(persisted) == "table" and persisted.Receipts or nil)
	if receipts[receiptId] then return result, false end
	if result.Receipts[receiptId] then return nil end -- never trust an unpersisted ID
	if result.Coins + amount > maxCoins then return nil end
	result.Coins += amount
	result.Receipts[receiptId] = amount
	return result, true
end

function Ledger.reconcile(localData, committed, maxCoins)
	local merged = Ledger.merge(localData, committed, maxCoins)
	if not merged then return nil end
	local recovered = merged.Coins - localData.Coins
	localData.Coins, localData.Receipts = merged.Coins, merged.Receipts
	return recovered
end

return Ledger
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Progression</string>
            <string name="Source"><![CDATA[-- Deterministic daily goals and lifetime XP. Call with server-owned counters
-- and an explicit Unix time; clients never decide rewards or progress.
local Progression = {}

local METRICS = { "Rounds", "Actions", "Wins" }
local MAX_COUNT = 1000000
local LEVEL_XP = 100
local MAX_LEVEL = 1000
local MAX_XP = (MAX_LEVEL - 1) * LEVEL_XP

local function whole(value, maximum)
	if type(value) ~= "number" or value ~= value or value <= 0 or value == math.huge then
		return 0
	end
	return math.min(math.floor(value), maximum)
end

local function currentDay(now)
	return math.floor(whole(now, 100000000000) / 86400)
end

local function missions(config)
	if type(config) == "table" and type(config.DailyMissions) == "table" then
		return config.DailyMissions
	end
	return {}
end

local function validMission(mission)
	if type(mission) ~= "table" or type(mission.Key) ~= "string" or mission.Key == "" then
		return false
	end
	local recognized = mission.Metric == "Rounds" or mission.Metric == "Actions" or mission.Metric == "Wins"
	return recognized and whole(mission.Target, MAX_COUNT) > 0
end

function Progression.clean(raw, now, config)
	local progress = {
		XP = 0,
		Day = currentDay(now),
		Counts = { Rounds = 0, Actions = 0, Wins = 0 },
		Claimed = {},
	}
	if type(raw) ~= "table" then
		return progress
	end
	progress.XP = whole(raw.XP, MAX_XP)
	-- Unknown, past or future dates cannot carry daily rewards into today.
	if raw.Day ~= progress.Day then
		return progress
	end
	if type(raw.Counts) == "table" then
		for _, metric in ipairs(METRICS) do
			progress.Counts[metric] = whole(raw.Counts[metric], MAX_COUNT)
		end
	end
	if type(raw.Claimed) == "table" then
		for _, mission in ipairs(missions(config)) do
			if validMission(mission) and raw.Claimed[mission.Key] == true then
				progress.Claimed[mission.Key] = true
			end
		end
	end
	return progress
end

local function refresh(progress, now, config)
	local clean = Progression.clean(progress, now, config)
	if type(progress) ~= "table" then
		return clean
	end
	progress.XP = clean.XP
	progress.Day = clean.Day
	progress.Counts = clean.Counts
	progress.Claimed = clean.Claimed
	return progress
end

function Progression.record(progress, delta, now, config)
	progress = refresh(progress, now, config)
	delta = if type(delta) == "table" then delta else {}
	local increments = {}
	for _, metric in ipairs(METRICS) do
		increments[metric] = whole(delta[metric], MAX_COUNT)
		progress.Counts[metric] = math.min(progress.Counts[metric] + increments[metric], MAX_COUNT)
	end
	local roundXP = if type(config) == "table" then whole(config.XPPerRound, MAX_XP) else 0
	local winXP = if type(config) == "table" then whole(config.XPPerWin, MAX_XP) else 0
	progress.XP = math.min(progress.XP + increments.Rounds * roundXP + increments.Wins * winXP, MAX_XP)
	return progress
end

function Progression.claim(progress, key, now, config)
	progress = refresh(progress, now, config)
	if type(key) ~= "string" then
		return 0, "Misión inválida."
	end
	for _, mission in ipairs(missions(config)) do
		if validMission(mission) and mission.Key == key then
			if progress.Claimed[key] then
				return 0, "Ya recogiste esta recompensa hoy."
			end
			if progress.Counts[mission.Metric] < whole(mission.Target, MAX_COUNT) then
				return 0, "Completa la misión para recoger su recompensa."
			end
			local reward = whole(mission.Reward, MAX_COUNT)
			if reward <= 0 then
				return 0, "La recompensa no está disponible."
			end
			progress.Claimed[key] = true
			return reward, "Recompensa de misión recogida."
		end
	end
	return 0, "Misión inválida."
end

function Progression.view(progress, now, config)
	local clean = Progression.clean(progress, now, config)
	local level = math.min(math.floor(clean.XP / LEVEL_XP) + 1, MAX_LEVEL)
	local view = {
		XP = clean.XP,
		Level = level,
		NextLevelXP = LEVEL_XP,
		LevelProgress = if level == MAX_LEVEL then LEVEL_XP else clean.XP % LEVEL_XP,
		Missions = {},
	}
	for _, mission in ipairs(missions(config)) do
		if validMission(mission) then
			local target = whole(mission.Target, MAX_COUNT)
			local count = clean.Counts[mission.Metric]
			table.insert(view.Missions, {
				Key = mission.Key,
				Name = if type(mission.Name) == "string" then mission.Name else mission.Key,
				Count = math.min(count, target),
				Target = target,
				Reward = whole(mission.Reward, MAX_COUNT),
				Claimed = clean.Claimed[mission.Key] == true,
				Complete = count >= target,
			})
		end
	end
	return view
end

return Progression
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Rules</string>
            <string name="Source"><![CDATA[-- Pure rules: no Roblox services, random state or client-provided scores.
local Rules = {}

function Rules.cleanProfile(raw, paletteCount)
	local profile = { Coins = 0, Wins = 0, Selected = 1, Owned = { ["1"] = true } }
	if type(raw) ~= "table" then
		return profile
	end
	for _, key in ipairs({ "Coins", "Wins" }) do
		local value = raw[key]
		if type(value) == "number" and value == value and value > 0 and value < math.huge then
			profile[key] = math.min(math.floor(value), 100000000)
		end
	end
	if type(raw.Owned) == "table" then
		for i = 1, paletteCount do
			if raw.Owned[tostring(i)] == true then
				profile.Owned[tostring(i)] = true
			end
		end
	end
	if type(raw.Selected) == "number" and raw.Selected % 1 == 0 and profile.Owned[tostring(raw.Selected)] then
		profile.Selected = raw.Selected
	end
	return profile
end

function Rules.purchase(profile, index, palettes, vip)
	if type(index) ~= "number" or index % 1 ~= 0 or not palettes[index] then
		return false, "Selección inválida."
	end
	local key = tostring(index)
	if palettes[index].Access == "VIP" then
		if vip ~= true then return false, "Esta aura requiere el pase VIP Prisma." end
		profile.Owned[key] = true
		profile.Selected = index
		return true, "Aura VIP equipada."
	end
	if not profile.Owned[key] then
		local cost = palettes[index].Cost
		if profile.Coins < cost then
			return false, "Necesitas más monedas. Se consiguen jugando."
		end
		profile.Coins -= cost
		profile.Owned[key] = true
	end
	profile.Selected = index
	return true, "Color equipado."
end

function Rules.reward(success, contributed, alive, winCoins, participationCoins)
	if not contributed then
		return 0, 0
	end
	if success and alive then
		return winCoins, 1
	end
	return participationCoins, 0
end

return Rules
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
    <Item class="Folder" referent="14">
      <Properties>
        <string name="Name">ServerScriptService</string>
      </Properties>
      <Item class="Folder" referent="15">
        <Properties>
          <string name="Name">ColorChaosServer</string>
        </Properties>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Commerce</string>
            <string name="Source"><![CDATA[-- Server-owned, deterministic Robux purchases. Never grant from prompt events.
-- Persistence is deliberately delegated: currency and receipt ID must commit in
-- the same UpdateAsync before PersistentGrant returns true.
local Commerce = {}

local function positiveInteger(value)
	return type(value) == "number" and value == value and value > 0
		and value <= 9007199254740991 and value % 1 == 0
end

local function validKey(value)
	return type(value) == "string" and #value > 0 and #value <= 80
end

function Commerce.new(deps)
	assert(type(deps) == "table", "Commerce requires dependencies")
	assert(type(deps.GetProfile) == "function", "Commerce requires GetProfile")
	assert(type(deps.PersistentGrant) == "function", "Commerce requires atomic PersistentGrant")
	local config = deps.Config or {}
	local settings = type(config.Commerce) == "table" and config.Commerce or {}
	local marketplace, players = deps.MarketplaceService, deps.Players
	local decision = deps.PurchaseDecision or Enum.ProductPurchaseDecision
	local clock = deps.Clock or os.clock
	local warnMessage = deps.Warn or warn
	local notify = deps.Notify or function() end
	local refresh = deps.Refresh or function() end
	local maxCoins = positiveInteger(config.MaxCoins) and config.MaxCoins or 100000000
	local maxReceipts = positiveInteger(config.MaxReceipts) and config.MaxReceipts or 10000
	local products, productByKey, productById = {}, {}, {}
	local keyCounts, idCounts = {}, {}
	local lastRequests, pending = {}, {}
	local started = false
	local controller = {}

	for _, raw in ipairs(type(settings.Products) == "table" and settings.Products or {}) do
		if type(raw) == "table" and validKey(raw.Key) then
			local item = {
				Key = raw.Key,
				Kind = "Product",
				Name = type(raw.Name) == "string" and raw.Name or raw.Key,
				Description = type(raw.Description) == "string" and raw.Description or "Monedas para cosméticos de resultado conocido.",
				ProductId = raw.ProductId,
				Coins = raw.Coins,
			}
			table.insert(products, item)
			keyCounts[item.Key] = (keyCounts[item.Key] or 0) + 1
			if positiveInteger(item.ProductId) then
				idCounts[item.ProductId] = (idCounts[item.ProductId] or 0) + 1
			end
		end
	end
	for _, item in ipairs(products) do
		item.Valid = positiveInteger(item.ProductId) and positiveInteger(item.Coins)
			and item.Coins <= maxCoins and keyCounts[item.Key] == 1 and idCounts[item.ProductId] == 1
		if item.Valid then
			productById[item.ProductId], productByKey[item.Key] = item, item
		elseif keyCounts[item.Key] ~= 1 or (positiveInteger(item.ProductId) and idCounts[item.ProductId] ~= 1) then
			warnMessage("Color Chaos: producto desactivado por ID o clave duplicados: " .. item.Key)
		elseif item.ProductId ~= nil and item.ProductId ~= 0 then
			warnMessage("Color Chaos: configuración de producto inválida: " .. item.Key)
		end
	end
	local rawPass = type(settings.VIP) == "table" and settings.VIP or {}
	local pass = {
		Key = validKey(rawPass.Key) and rawPass.Key or "vip",
		Kind = "Pass",
		Name = type(rawPass.Name) == "string" and rawPass.Name or "VIP Prisma",
		Description = type(rawPass.Description) == "string" and rawPass.Description or "Distintivo y efectos cosméticos permanentes; no cambia las rondas.",
		PassId = rawPass.PassId,
		Valid = positiveInteger(rawPass.PassId),
	}

	local function online(player)
		return player ~= nil and positiveInteger(player.UserId)
			and players:GetPlayerByUserId(player.UserId) == player
	end

	local function loaded(player)
		if not online(player) then return nil end
		local record = deps.GetProfile(player)
		return record and record.Ready ~= false and record or nil
	end

	local function purchaseBusy(record)
		return record and (record.PendingPaid ~= nil or record.UncertainReceipt ~= nil
			or record.LastSaveFailed == true or record.Leaving == true or record.Saving == true)
	end

	local function hasReceiptRoom(record)
		local receipts = record and record.Data and record.Data.Receipts
		if type(receipts) ~= "table" then return true end
		local count = 0
		for _ in pairs(receipts) do
			count += 1
			if count >= maxReceipts then return false end
		end
		return true
	end

	local function roomForProduct(record, product)
		local coins = record and record.Data and record.Data.Coins
		return not purchaseBusy(record) and hasReceiptRoom(record)
			and type(coins) == "number" and coins == coins and coins >= 0
			and coins <= maxCoins - product.Coins
	end

	local function reject(player, message)
		notify(player, message)
		return false, message
	end

	function controller.getCatalog(player)
		local record, result = loaded(player), {}
		for _, product in ipairs(products) do
			table.insert(result, {
				Key = product.Key, Kind = "Product", Name = product.Name,
				Description = product.Description, Coins = product.Coins,
				Id = positiveInteger(product.ProductId) and product.ProductId or 0,
				Available = product.Valid and record ~= nil and record.Writable == true and roomForProduct(record, product),
				Owned = false,
			})
		end
		table.insert(result, {
			Key = pass.Key, Kind = "Pass", Name = pass.Name, Description = pass.Description,
			Id = positiveInteger(pass.PassId) and pass.PassId or 0,
			Available = pass.Valid and record ~= nil,
			Owned = record ~= nil and record.VIP == true,
		})
		return result
	end

	function controller.refreshPasses(player)
		local record = loaded(player)
		if not record then return false, "Tu perfil todavía no está disponible." end
		if not pass.Valid then
			record.VIP, record.VIPKnown = false, true
			return true
		end
		local ok, owns = pcall(function()
			return marketplace:UserOwnsGamePassAsync(player.UserId, pass.PassId)
		end)
		if not ok or type(owns) ~= "boolean" then
			return false, "Roblox no pudo confirmar tu pase. Intenta de nuevo más tarde."
		end
		-- A player may leave or obtain another profile while the API yields.
		if loaded(player) ~= record then return false, "Tu sesión cambió." end
		record.VIP, record.VIPKnown = owns, true
		pcall(refresh, player)
		return true
	end

	function controller.requestPurchase(player, kind, key)
		local record = loaded(player)
		if not record then return reject(player, "Espera a que termine de cargar tu perfil.") end
		if (kind ~= "Product" and kind ~= "Pass") or not validKey(key) then
			return reject(player, "Compra no válida.")
		end
		local now, userId = clock(), player.UserId
		if lastRequests[userId] and now - lastRequests[userId] < 3 then
			return false, "Espera un momento antes de abrir otra compra."
		end
		if pending[userId] and now - pending[userId].At < 90 then
			return false, "Termina o cierra la compra que tienes abierta."
		end
		local id, item
		if kind == "Product" then
			item = productByKey[key]
			if not item then return reject(player, "Este producto todavía no está configurado.") end
			if record.Writable ~= true then
				return reject(player, "Las compras requieren guardado activo. No se cobran productos en esta sesión.")
			end
			if purchaseBusy(record) then
				return reject(player, "Estamos confirmando tu progreso o una compra anterior. Espera antes de comprar otra vez.")
			end
			if not hasReceiptRoom(record) then
				return reject(player, "Este perfil alcanzó el límite seguro de compras. Puedes seguir jugando y usar tus monedas.")
			end
			if not roomForProduct(record, item) then
				return reject(player, "Gasta algunas monedas antes de comprar otro paquete.")
			end
			id = item.ProductId
		else
			if key ~= pass.Key or not pass.Valid then
				return reject(player, "Este pase todavía no está configurado.")
			end
			-- Ownership lookup yields too: reserve before it, not just before
			-- PromptGamePassPurchase, to prevent simultaneous pass requests.
			lastRequests[userId] = now
			pending[userId] = { Kind = kind, Id = pass.PassId, At = now }
			local verified, message = controller.refreshPasses(player)
			if not verified then
				pending[userId] = nil
				return reject(player, message)
			end
			if record.VIP == true then
				pending[userId] = nil
				return reject(player, "Ya tienes el pase VIP Prisma.")
			end
			id = pass.PassId
		end
		-- Reserve before a yielding platform prompt, so overlapping remotes cannot
		-- open multiple prompts. Only configured server IDs reach Marketplace.
		lastRequests[userId] = now
		pending[userId] = { Kind = kind, Id = id, At = now }
		local ok = pcall(function()
			if kind == "Product" then
				marketplace:PromptProductPurchase(player, id)
			else
				marketplace:PromptGamePassPurchase(player, id)
			end
		end)
		if not ok then
			pending[userId] = nil
			return reject(player, "Roblox no pudo abrir la compra. Intenta más tarde.")
		end
		return true, "Compra abierta en Roblox."
	end

	function controller.start()
		if started then return end
		started = true
		marketplace.ProcessReceipt = function(receipt)
			if type(receipt) ~= "table" or not positiveInteger(receipt.ProductId)
				or not positiveInteger(receipt.PlayerId) or type(receipt.PurchaseId) ~= "string"
				or #receipt.PurchaseId == 0 or #receipt.PurchaseId > 200 then
				return decision.NotProcessedYet
			end
			local product = productById[receipt.ProductId]
			if not product then return decision.NotProcessedYet end
			local player = players:GetPlayerByUserId(receipt.PlayerId)
			local record = loaded(player)
			if not record or record.Writable ~= true then return decision.NotProcessedYet end
			local ok, committed, message = pcall(deps.PersistentGrant, player, receipt, product)
			if not ok or committed ~= true then return decision.NotProcessedYet end
			-- Refresh failures cannot undo a receipt that already committed durably.
			pcall(refresh, player)
			if type(message) == "string" and #message > 0 then pcall(notify, player, message) end
			return decision.PurchaseGranted
		end
		marketplace.PromptProductPurchaseFinished:Connect(function(userId, productId)
			local request = pending[userId]
			if request and request.Kind == "Product" and request.Id == productId then
				pending[userId] = nil
			end
			-- Closing the prompt is never proof of payment. No rewards here.
		end)
		marketplace.PromptGamePassPurchaseFinished:Connect(function(player, passId)
			if not pass.Valid or passId ~= pass.PassId or not online(player) then return end
			local request = pending[player.UserId]
			if request and request.Kind == "Pass" and request.Id == passId then pending[player.UserId] = nil end
			local verified, message = controller.refreshPasses(player)
			if not verified then notify(player, message) end
		end)
		players.PlayerRemoving:Connect(function(player)
			lastRequests[player.UserId], pending[player.UserId] = nil, nil
		end)
	end

	return controller
end

return Commerce
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Cosmetics</string>
            <string name="Source"><![CDATA[-- Accessories never replace the user's avatar, collision groups or movement settings.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Config = require(ReplicatedStorage.ColorChaos.Config)
local Catalog = require(ReplicatedStorage.ColorChaos.Catalog)
local Cosmetics = {}
local activeEmotes = setmetatable({}, { __mode = "k" })
local lastEmote, lastReaction = setmetatable({}, { __mode = "k" }), setmetatable({}, { __mode = "k" })
local INK = Color3.fromRGB(36, 48, 73)
local WHITE = Color3.fromRGB(246, 241, 222)
local function rgb(value) return Color3.fromRGB(value[1], value[2], value[3]) end
local function itemFor(data, kind, vip)
	local id = type(data.Equipped) == "table" and data.Equipped[kind] or Catalog.Defaults[kind]
	local item = Catalog.ById[id]
	if not item or item.Kind ~= kind then return Catalog.ById[Catalog.Defaults[kind]] end
	local owned = type(data.CosmeticsOwned) == "table" and data.CosmeticsOwned[item.Id] == true
	if item.Access == "VIP" then owned = vip == true end
	if item.Id == Catalog.Defaults[kind] then owned = true end
	return if owned then item else Catalog.ById[Catalog.Defaults[kind]]
end
local function stopEmote(player)
	local state = activeEmotes[player]
	if not state then return end
	activeEmotes[player] = nil
	for _, connection in ipairs(state.Connections) do connection:Disconnect() end
	for _, tween in ipairs(state.Tweens) do tween:Cancel() end
	for motor, original in pairs(state.Originals) do
		if motor.Parent then motor.C0 = original end
	end
	if state.Effect then state.Effect:Destroy() end
end
function Cosmetics.stopEmote(player) stopEmote(player) end

local function attach(folder, body, name, size, offset, color, shape)
	local part = Instance.new(if shape == "Wedge" then "WedgePart" else "Part")
	part.Name, part.Size = name, size
	part.CFrame = body.CFrame * offset
	part.Color, part.Material = color, Enum.Material.SmoothPlastic
	part.Anchored, part.Massless = false, true
	part.CanCollide, part.CanTouch, part.CanQuery, part.CastShadow = false, false, false, false
	if shape == "Ball" then part.Shape = Enum.PartType.Ball end
	part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	part:SetAttribute("ColorChaosCosmetic", true)
	part.Parent = folder
	local weld = Instance.new("WeldConstraint")
	weld.Name, weld.Part0, weld.Part1, weld.Parent = "CosmeticWeld", body, part, part
	return part
end
local function addSuit(folder, character, item)
	if item.Style == "None" then return end
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	local head = character:FindFirstChild("Head")
	if not torso or not torso:IsA("BasePart") then return end
	local color, accent = rgb(item.Color), rgb(item.Accent)
	local w, h, d = torso.Size.X, torso.Size.Y, torso.Size.Z
	local function panel(name, x, y, z, sx, sy, sz, shade, shape, angle)
		return attach(folder, torso, name, Vector3.new(sx, sy, sz), CFrame.new(x, y, z) * (angle or CFrame.identity), shade or color, shape)
	end
	panel("ChestPlate", 0, 0, -d / 2 - 0.085, w * 0.87, h * 0.83, 0.18, color, "Ball")
	panel("PrismaBadge", -w * 0.23, h * 0.17, -d / 2 - 0.19, 0.24, 0.29, 0.08, accent, "Wedge")
	panel("UtilityBelt", 0, -h * 0.37, -d / 2 - 0.17, w * 0.85, 0.12, 0.11, INK)
	for _, side in ipairs({ -1, 1 }) do
		panel("ShoulderTrim", side * w * 0.46, h * 0.37, 0, w * 0.34, 0.22, d * 1.13, accent, "Ball")
	end
	if item.Style == "Garden" then
		for _, side in ipairs({ -1, 1 }) do
			panel("GardenPocket", side * w * 0.25, -h * 0.10, -d / 2 - 0.20, w * 0.28, h * 0.23, 0.16, accent, "Ball")
		end
		panel("LeafCape", 0, 0, d / 2 + 0.14, w * 0.95, h * 1.21, 0.13, color, "Wedge")
	elseif item.Style == "Astronaut" then
		panel("LifeSupport", 0, 0, d / 2 + 0.25, w * 0.77, h * 0.85, 0.46, WHITE, "Ball")
		panel("FlightConsole", 0, h * 0.06, -d / 2 - 0.22, w * 0.45, h * 0.33, 0.12, WHITE)
		for lamp = -1, 1 do panel("ConsoleLight", lamp * w * 0.11, h * 0.07, -d / 2 - 0.30, 0.11, 0.11, 0.03, accent, "Ball") end
	elseif item.Style == "Pilot" then
		for _, side in ipairs({ -1, 1 }) do panel("Harness", side * w * 0.19, 0, -d / 2 - 0.21, 0.12, h * 0.78, 0.06, accent) end
		panel("Buckle", 0, -h * 0.22, -d / 2 - 0.26, 0.30, 0.20, 0.06, WHITE)
	elseif item.Style == "Explorer" then
		panel("ExplorerPack", 0, 0, d / 2 + 0.27, w * 0.70, h * 0.94, 0.45, color, "Ball")
		panel("BlanketRoll", 0, h * 0.47, d / 2 + 0.30, w * 0.81, 0.27, 0.33, accent, "Ball")
		panel("ScarfTail", -w * 0.26, -h * 0.12, -d / 2 - 0.23, 0.25, h * 0.77, 0.07, accent)
	elseif item.Style == "Knight" or item.Style == "Prism" then
		panel("Cape", 0, -h * 0.10, d / 2 + 0.20, w * 1.09, h * 1.45, 0.11, accent)
		for _, side in ipairs({ -1, 1 }) do
			panel("CrystalPauldron", side * w * 0.49, h * 0.45, 0, w * 0.40, 0.38, d * 1.2, color, "Wedge", CFrame.Angles(0, 0, side * 0.12))
		end
		panel("ChestCrystal", 0, h * 0.14, -d / 2 - 0.24, w * 0.24, h * 0.41, 0.12, accent, "Wedge")
	end
	if head and head:IsA("BasePart") then
		local hw, hh, hd = head.Size.X, head.Size.Y, head.Size.Z
		if item.Style == "Astronaut" then
			-- Open face guard: no opaque sphere hides the player's face or accessories.
			for _, side in ipairs({ -1, 1 }) do
				attach(folder, head, "HelmetSide", Vector3.new(0.16, hh * 1.1, hd * 0.95), CFrame.new(side * (hw / 2 + 0.08), 0, 0), WHITE, "Ball")
			end
			attach(folder, head, "HelmetCrown", Vector3.new(hw * 1.12, 0.15, hd), CFrame.new(0, hh / 2 + 0.10, 0), WHITE, "Ball")
		elseif item.Style == "Garden" then
			attach(folder, head, "SunhatBrim", Vector3.new(hw * 1.42, 0.13, hd * 1.36), CFrame.new(0, hh / 2 + 0.10, 0), accent, "Ball")
			attach(folder, head, "SunhatCrown", Vector3.new(hw * 0.90, 0.36, hd), CFrame.new(0, hh / 2 + 0.28, 0), color, "Ball")
		elseif item.Style == "Prism" then
			for spike = -1, 1 do
				attach(folder, head, "PrismCrown", Vector3.new(hw * 0.23, 0.38 + (if spike == 0 then 0.12 else 0), 0.18), CFrame.new(spike * hw * 0.29, hh / 2 + 0.25, -hd * 0.39), accent, "Wedge")
			end
		end
	end
end

local function addTrail(folder, root, item)
	if item.Style == "None" then return end
	local a, b = Instance.new("Attachment"), Instance.new("Attachment")
	a.Name, b.Name = "ColorChaosTrailA", "ColorChaosTrailB"
	a.Position, b.Position = Vector3.new(-0.66, 0.2, 0.5), Vector3.new(0.66, 0.2, 0.5)
	a.Parent, b.Parent = root, root
	local trail = Instance.new("Trail")
	trail.Name, trail.Attachment0, trail.Attachment1 = "EquippedTrail", a, b
	trail.FaceCamera, trail.LightEmission = true, 0.55
	trail.Lifetime, trail.MinLength = if item.Style == "Comet" then 0.48 else 0.30, 0.10
	trail.Color = ColorSequence.new(rgb(item.Color), rgb(item.Accent))
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.12), NumberSequenceKeypoint.new(1, 1) })
	trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0.08) })
	trail.Parent = folder
	if item.Style == "Prism" then
		trail.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 144, 188)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(174, 155, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(108, 242, 220)) })
	end
end

function Cosmetics.apply(player, data, vip)
	local character = player.Character
	if not character or type(data) ~= "table" then return false end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then return false end
	stopEmote(player)
	local previous = character:FindFirstChild("ColorChaosCosmetics")
	if previous then previous:Destroy() end
	for _, name in ipairs({ "ColorChaosTrailA", "ColorChaosTrailB" }) do
		local attachment = root:FindFirstChild(name)
		if attachment then attachment:Destroy() end
	end
	local folder = Instance.new("Model")
	folder.Name, folder.Parent = "ColorChaosCosmetics", character
	addSuit(folder, character, itemFor(data, "Suit", vip))
	local trailItem = itemFor(data, "Trail", vip)
	-- Legacy aura purchases remain visible, including their original trail benefit.
	local index = type(data.Selected) == "number" and data.Selected or 1
	local palette = Config.Palettes and Config.Palettes[index]
	if palette and ((palette.Access == "VIP" and vip) or (palette.Access ~= "VIP" and (index == 1 or type(data.Owned) == "table" and data.Owned[tostring(index)]))) then
		local aura = Instance.new("Highlight")
		aura.Name, aura.Adornee = "LegacyAura", character
		aura.FillColor, aura.OutlineColor = palette.Color, palette.Color
		aura.FillTransparency, aura.OutlineTransparency = 0.92, 0.42
		aura.DepthMode, aura.Parent = Enum.HighlightDepthMode.Occluded, folder
		if trailItem.Style == "None" and palette.Trail then
			trailItem = { Style = "Ribbon", Color = { palette.Color.R * 255, palette.Color.G * 255, palette.Color.B * 255 }, Accent = { 246, 241, 222 } }
		end
	end
	addTrail(folder, root, trailItem)
	local head = character:FindFirstChild("Head")
	if vip and head then
		local gui = Instance.new("BillboardGui")
		gui.Name, gui.Adornee, gui.Size = "VIPTitle", head, UDim2.fromOffset(120, 24)
		gui.StudsOffset, gui.MaxDistance, gui.AlwaysOnTop = Vector3.new(0, 2.3, 0), 75, false
		local text = Instance.new("TextLabel")
		text.Size, text.BackgroundTransparency = UDim2.fromScale(1, 1), 1
		text.Text, text.Font, text.TextSize = "✦ VIP PRISMA", Enum.Font.GothamBold, 14
		text.TextColor3, text.TextStrokeTransparency = Color3.fromRGB(222, 196, 255), 0.65
		text.Parent, gui.Parent = gui, folder
	end
	return true
end

local validEmotes = { Wave = true, Cheer = true, Dance = true, Spin = true, Bow = true, Float = true }
function Cosmetics.playEmote(player, style)
	local item = Catalog.ById[style]
	if item then style = if item.Kind == "Emote" then item.Style else nil end
	if not validEmotes[style] then return false end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or humanoid.MoveDirection.Magnitude > 0.05 then return false end
	local now = os.clock()
	if lastEmote[player] and now - lastEmote[player] < 2 then return false end
	lastEmote[player] = now
	stopEmote(player)
	local motors = {}
	for _, descendant in ipairs(character:GetDescendants()) do
		if descendant:IsA("Motor6D") then
			local name = string.gsub(descendant.Name, " ", "")
			if name == "RightShoulder" or name == "LeftShoulder" or name == "Waist" or name == "Neck" then motors[name] = descendant end
		end
	end
	if not motors.RightShoulder and not motors.LeftShoulder then return false end
	local state = { Originals = {}, Connections = {}, Tweens = {} }
	for _, motor in pairs(motors) do state.Originals[motor] = motor.C0 end
	activeEmotes[player] = state
	local function cancelIfMoving(speed) if speed > 0.1 and activeEmotes[player] == state then stopEmote(player) end end
	table.insert(state.Connections, humanoid.Running:Connect(cancelIfMoving))
	table.insert(state.Connections, humanoid.Jumping:Connect(function(jumping) if jumping and activeEmotes[player] == state then stopEmote(player) end end))
	table.insert(state.Connections, humanoid.Died:Connect(function() if activeEmotes[player] == state then stopEmote(player) end end))
	local function pose(name, x, y, z, seconds)
		local motor = motors[name]
		if not motor or not motor.Parent then return end
		local tween = TweenService:Create(motor, TweenInfo.new(seconds, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { C0 = state.Originals[motor] * CFrame.Angles(x, y, z) })
		table.insert(state.Tweens, tween)
		tween:Play()
	end
	task.spawn(function()
		for beat = 1, 6 do
			if activeEmotes[player] ~= state or player.Character ~= character or not character.Parent then break end
			local swing = if beat % 2 == 0 then 1 else -1
			if style == "Wave" then
				pose("RightShoulder", 0.1, 0.2, -1.55 + swing * 0.27, 0.23)
				pose("Neck", 0, 0, swing * 0.04, 0.23)
			elseif style == "Cheer" then
				pose("RightShoulder", -0.1, 0, -1.85 + swing * 0.18, 0.23)
				pose("LeftShoulder", -0.1, 0, 1.85 - swing * 0.18, 0.23)
			elseif style == "Dance" then
				pose("RightShoulder", swing * 0.35, 0, -0.65, 0.23)
				pose("LeftShoulder", -swing * 0.35, 0, 0.65, 0.23)
				pose("Waist", 0, swing * 0.28, swing * 0.10, 0.23)
			elseif style == "Spin" then
				-- Torso twist, not character rotation: root position and controls never change.
				pose("RightShoulder", 0, swing * 0.32, -1.08, 0.23)
				pose("LeftShoulder", 0, -swing * 0.32, 1.08, 0.23)
				pose("Waist", 0, swing * 0.52, 0, 0.23)
			elseif style == "Bow" then
				pose("Waist", if beat < 5 then 0.44 else 0, 0, 0, 0.25)
				pose("Neck", if beat < 5 then 0.24 else 0, 0, 0, 0.25)
				pose("RightShoulder", -0.25, 0, -0.25, 0.25)
			else
				pose("RightShoulder", 0.12, 0, -0.95 + swing * 0.10, 0.23)
				pose("LeftShoulder", 0.12, 0, 0.95 - swing * 0.10, 0.23)
				pose("Neck", -0.12, swing * 0.12, 0, 0.23)
			end
			task.wait(0.27)
		end
		if activeEmotes[player] == state then stopEmote(player) end
	end)
	return true
end

function Cosmetics.playReaction(player, input)
	local item = if type(input) == "table" then Catalog.ById[input.Id] else Catalog.ById[input]
	if not item or item.Kind ~= "Reaction" then
		for _, entry in ipairs(Catalog.Items) do if entry.Kind == "Reaction" and entry.Style == input then item = entry; break end end
	end
	if not item or item.Kind ~= "Reaction" then return false end
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not head or not humanoid or humanoid.Health <= 0 then return false end
	local now = os.clock()
	if lastReaction[player] and now - lastReaction[player] < 2 then return false end
	lastReaction[player] = now
	local prior = character:FindFirstChild("ColorChaosReaction")
	if prior then prior:Destroy() end
	local gui = Instance.new("BillboardGui")
	gui.Name, gui.Adornee, gui.Size = "ColorChaosReaction", head, UDim2.fromOffset(150, 72)
	gui.AlwaysOnTop, gui.MaxDistance, gui.StudsOffset = false, 90, Vector3.new(0, 3.1, 0)
	local label = Instance.new("TextLabel")
	label.Name, label.Size, label.BackgroundTransparency = "Bubble", UDim2.fromScale(1, 1), 1
	label.Text, label.Font, label.TextScaled = item.Glyph, Enum.Font.GothamBlack, true
	label.TextColor3, label.TextStrokeColor3, label.TextStrokeTransparency = rgb(item.Color), INK, 0.35
	label.Parent, gui.Parent = gui, character
	TweenService:Create(gui, TweenInfo.new(2.6, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { StudsOffset = Vector3.new(0, 4.2, 0) }):Play()
	task.delay(1.6, function()
		if label.Parent then TweenService:Create(label, TweenInfo.new(0.8), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play() end
	end)
	Debris:AddItem(gui, 2.6)
	return true
end
Cosmetics.react = Cosmetics.playReaction
function Cosmetics.cleanup(player)
	stopEmote(player)
	lastEmote[player], lastReaction[player] = nil, nil
end
return Cosmetics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Leaderboards</string>
            <string name="Source"><![CDATA[-- Global boards contain confirmed persisted progress only. The controller invokes
-- publish after a profile save succeeds; API failure never prevents joining a game.
local Leaderboards = {}
local METRICS = {
	{ Key = "Wins", Suffix = "GlobalWins_v2" },
	{ Key = "Streak", Suffix = "GlobalStreak_v2" },
	{ Key = "Level", Suffix = "GlobalLevel_v2" },
}

local function finiteInteger(value, maximum)
	if type(value) ~= "number" or value ~= value or math.abs(value) == math.huge or value < 0 then return nil end
	return math.min(maximum, math.floor(value))
end

local function copyRows(rows)
	local copy = {}
	for _, row in ipairs(rows) do table.insert(copy, table.clone(row)) end
	return copy
end

function Leaderboards.new(dependencies)
	local enabled = dependencies.Enabled == true
	local now = dependencies.Now or os.clock
	local warnFn = dependencies.Warn or warn
	local config = dependencies.Config or {}
	local refreshSeconds = config.LeaderboardRefreshSeconds or 60
	local writeSeconds = config.LeaderboardWriteSeconds or 60
	local maximum = config.MaxCoins or 100000000
	local stores, writes, names = {}, {}, {}
	local current = { Wins = {}, Streak = {}, Level = {}, Status = enabled and "Cargando clasificación global…" or "Disponible en servidores publicados." }
	local lastRefresh, refreshing = -math.huge, false
	local api = {}

	local function getStore(metric)
		if stores[metric.Key] then return stores[metric.Key] end
		local ok, value = pcall(function()
			return dependencies.DataStoreService:GetOrderedDataStore((config.DataStoreName or "ColorChaos_Player_v1") .. "_" .. metric.Suffix)
		end)
		if ok and value then stores[metric.Key] = value; return value end
		warnFn("[ColorChaos] No se pudo abrir la clasificación " .. metric.Key)
		return nil
	end

	local function nameFor(id)
		if names[id] then return names[id] end
		if dependencies.NameForUser then
			local ok, name = pcall(dependencies.NameForUser, id)
			if ok and type(name) == "string" and #name > 0 then names[id] = name; return name end
		end
		-- A failed lookup is not cached so subsequent refreshes can restore the name.
		return "Jugador " .. tostring(id)
	end

	function api.publish(player, data)
		if not enabled or type(data) ~= "table" or not player then return false end
		local id = finiteInteger(player.UserId, 9007199254740991)
		if not id or id <= 0 or player.UserId ~= id then return false end
		local progress = type(data.Progress) == "table" and data.Progress or {}
		local xp = finiteInteger(progress.XP, 100000000)
		local values = {
			Wins = data.Wins,
			Streak = data.BestStreak,
			Level = xp and math.min(1000, math.floor(xp / 100) + 1) or nil,
		}
		local anySuccess = false
		for _, metric in ipairs(METRICS) do
			local value = finiteInteger(values[metric.Key], maximum)
			if value then
				local key = tostring(id) .. ":" .. metric.Key
				local previous = writes[key]
				if not previous or (not previous.Busy and value > previous.Value and now() - previous.At >= writeSeconds) then
					local store = getStore(metric)
					if store then
						local marker = previous or { At = -math.huge, Value = -1 }
						marker.Busy = true
						writes[key] = marker
						local ok, confirmed = pcall(function()
							return store:UpdateAsync(tostring(id), function(persisted)
								return math.max(value, finiteInteger(persisted, 9007199254740991) or 0)
							end)
						end)
						marker.Busy = false
						local committed = finiteInteger(confirmed, maximum)
						if ok and committed and committed >= value then
							marker.Value, marker.At = committed, now()
							anySuccess = true
						else
							-- Failed attempts are throttled as well, but remain retryable.
							marker.At = now()
							warnFn("[ColorChaos] No se pudo actualizar la clasificación " .. metric.Key)
						end
					end
				end
			end
		end
		return anySuccess
	end

	function api.refresh()
		if not enabled or refreshing or now() - lastRefresh < refreshSeconds then return false end
		refreshing, lastRefresh = true, now()
		local successCount = 0
		for _, metric in ipairs(METRICS) do
			local store = getStore(metric)
			if store then
				local ok, entries = pcall(function() return store:GetSortedAsync(false, 10):GetCurrentPage() end)
				if ok and type(entries) == "table" then
					local rows, seen = {}, {}
					for _, entry in ipairs(entries) do
						local rawId = type(entry) == "table" and tonumber(entry.key) or nil
						local id = finiteInteger(rawId, 9007199254740991)
						local value = type(entry) == "table" and finiteInteger(entry.value, maximum) or nil
						if id and id > 0 and rawId == id and value and not seen[id] then
							seen[id] = true
							table.insert(rows, { UserId = id, Name = nameFor(id), Value = value })
							if #rows == 10 then break end
						end
					end
					current[metric.Key] = rows
					successCount += 1
				end
			end
		end
		refreshing = false
		current.Status = successCount == #METRICS and "Clasificación global" or "Clasificación temporalmente sin conexión."
		return successCount > 0
	end

	function api.snapshot()
		return {
			Wins = copyRows(current.Wins), Streak = copyRows(current.Streak), Level = copyRows(current.Level),
			Status = current.Status,
		}
	end

	return api
end

return Leaderboards
]]></string>
          </Properties>
        </Item>
        <Item class="Script" referent="19">
          <Properties>
            <string name="Name">Main</string>
            <bool name="Disabled">true</bool>
            <token name="RunContext">0</token>
            <string name="Source"><![CDATA[-- Ciudad Prisma. The saved world and spawn exist before this script runs.
-- Only the server decides membership, physical choices, rewards and purchases.
local function run()
	workspace:SetAttribute("ColorChaosBootStatus", "STARTING")
	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local DataStoreService = game:GetService("DataStoreService")
	local RunService = game:GetService("RunService")
	local HttpService = game:GetService("HttpService")
	local MarketplaceService = game:GetService("MarketplaceService")
	local PhysicsService = game:GetService("PhysicsService")
	local TweenService = game:GetService("TweenService")
	local Lighting = game:GetService("Lighting")
	local Config = require(ReplicatedStorage.ColorChaos.Config)
	local Settings = require(ReplicatedStorage.ColorChaos.GameSettings)
	local Catalog = require(ReplicatedStorage.ColorChaos.Catalog)
	local Characters = require(ReplicatedStorage.ColorChaos.Characters)
	local GameRules = require(ReplicatedStorage.ColorChaos.GameRules)
	local Economy = require(ReplicatedStorage.ColorChaos.Economy)
	local Ledger = require(ReplicatedStorage.ColorChaos.ProfileLedger)
	local Rules = require(ReplicatedStorage.ColorChaos.Rules)
	local Profiles = require(script.Parent.Profiles)
	local Leaderboards = require(script.Parent.Leaderboards)
	local Cosmetics = require(script.Parent.Cosmetics)
	local Commerce = require(script.Parent.Commerce)

	local world = assert(workspace:WaitForChild("ColorChaosWorld", 10), "Falta ColorChaosWorld. Importa la entrega completa.")
	local spawn = assert(world:FindFirstChild("LobbySpawn"), "Falta LobbySpawn en el mundo guardado.")
	local stages = assert(world:FindFirstChild("Stages"), "Falta el recorrido Stages.")
	local gates, gatePositions = {}, {}
	for index = 1, Settings.Stages do
		local sector = assert(stages:FindFirstChild(string.format("Stage%02d", index)), "Falta un sector del recorrido.")
		local group = assert(sector:FindFirstChild("Gates"), "Faltan las cinco puertas.")
		gates[index] = {}
		for lane = 1, 5 do
			local gate = assert(group:FindFirstChild("Gate" .. lane), "Falta una puerta.")
			local barrier = assert(gate:FindFirstChild("Barrier"), "Falta Barrier.")
			assert(gate:FindFirstChild("ChoicePad"), "Falta ChoicePad.")
			gates[index][lane], gatePositions[barrier] = gate, barrier.CFrame
		end
	end
	-- Also applied after an in-place update, which preserves the owner's Config.
	Lighting.ClockTime, Lighting.Brightness = 14.4, 2.6
	Lighting.GlobalShadows, Lighting.ExposureCompensation = true, 0.05
	Lighting.EnvironmentDiffuseScale, Lighting.EnvironmentSpecularScale = 0.72, 0.65
	Lighting.Ambient, Lighting.OutdoorAmbient = Color3.new(0.43, 0.49, 0.58), Color3.new(0.66, 0.71, 0.77)
	local function lightingEffect(className, name, properties)
		local effect = Lighting:FindFirstChild(name)
		if effect and not effect:IsA(className) then effect:Destroy(); effect = nil end
		if not effect then effect = Instance.new(className); effect.Name, effect.Parent = name, Lighting end
		for property, value in pairs(properties) do effect[property] = value end
	end
	lightingEffect("Atmosphere", "Atmosfera", { Density = 0.17, Offset = 0.25,
		Color = Color3.new(0.78, 0.88, 0.96), Decay = Color3.new(0.55, 0.64, 0.77), Glare = 0.12, Haze = 0.8 })
	lightingEffect("BloomEffect", "Neon", { Intensity = 0.14, Size = 20, Threshold = 1.35 })
	lightingEffect("ColorCorrectionEffect", "Color", { Brightness = 0, Contrast = 0.04,
		Saturation = 0.06, TintColor = Color3.new(1, 0.99, 0.98) })
	workspace.Gravity, workspace.FallenPartsDestroyHeight = 140, -60
	for _, name in ipairs({ "ColorChaosPlayers", "ColorChaosGhosts", "ColorChaosGates" }) do
		if not PhysicsService:IsCollisionGroupRegistered(name) then PhysicsService:RegisterCollisionGroup(name) end
	end
	PhysicsService:CollisionGroupSetCollidable("ColorChaosPlayers", "ColorChaosPlayers", false)
	PhysicsService:CollisionGroupSetCollidable("ColorChaosGhosts", "ColorChaosPlayers", false)
	PhysicsService:CollisionGroupSetCollidable("ColorChaosGhosts", "ColorChaosGhosts", false)
	PhysicsService:CollisionGroupSetCollidable("ColorChaosGhosts", "ColorChaosGates", false)
	for barrier in pairs(gatePositions) do barrier.CollisionGroup = "ColorChaosGates" end

	local shared = ReplicatedStorage.ColorChaos
	local events = shared:FindFirstChild("Remotes") or Instance.new("Folder")
	events.Name, events.Parent = "Remotes", shared
	local stateEvent = events:FindFirstChild("State") or Instance.new("RemoteEvent")
	stateEvent.Name, stateEvent.Parent = "State", events
	local actionEvent = events:FindFirstChild("Action") or Instance.new("RemoteEvent")
	actionEvent.Name, actionEvent.Parent = "Action", events
	local random, closing = Random.new(), false
	local sessions, initializing, lastActions = {}, {}, {}
	local currentRound, commerce, profiles
	local matchCounter, lastRoom = 0, {}
	local state = { Phase = "LOBBY", Seconds = 0, Stage = 0, StageCount = Settings.Stages,
		MatchId = 0, Message = "Bienvenido a Ciudad Prisma", Final = false, Solo = false }
	local store
	if not RunService:IsStudio() then
		local ok, result = pcall(function() return DataStoreService:GetDataStore(Config.DataStoreName) end)
		if ok then store = result else warn("Color Chaos: guardado no disponible; modo de sesión sin ventas de monedas.") end
	end
	local boards = Leaderboards.new({ DataStoreService = DataStoreService, Enabled = store ~= nil,
		Config = Config, NameForUser = function(id) return Players:GetNameFromUserIdAsync(id) end })
	local function online(player) return player.Parent == Players end
	local function body(player)
		local character = player.Character
		return character and character:FindFirstChild("HumanoidRootPart"), character and character:FindFirstChildOfClass("Humanoid")
	end
	local function readyPlayers()
		local result = {}
		for _, player in ipairs(Players:GetPlayers()) do
			local root, humanoid = body(player)
			local record = profiles and profiles.get(player)
			if sessions[player] and record and not record.Leaving and root and humanoid and humanoid.Health > 0 then
				table.insert(result, player)
			end
		end
		table.sort(result, function(a, b) return a.UserId < b.UserId end)
		return result
	end
	local function alivePlayers()
		local result = {}
		if currentRound then
			for player, member in pairs(currentRound.Members) do
				if member.Alive and online(player) then table.insert(result, player) end
			end
		end
		table.sort(result, function(a, b) return a.UserId < b.UserId end)
		return result
	end
	local function roomRows()
		if not currentRound then return lastRoom end
		local entries = {}
		for player, member in pairs(currentRound.Members) do
			table.insert(entries, { UserId = player.UserId, Name = player.DisplayName, Alive = member.Alive,
				CorrectThisMatch = member.CorrectThisMatch, LastChoiceAt = member.LastChoiceAt, Eligible = true })
		end
		return GameRules.rankRoom(entries)
	end
	local function personal(player, extra)
		if not online(player) then return end
		local payload = table.clone(state)
		local session = sessions[player]
		local member = currentRound and currentRound.Members[player]
		payload.Mode = session and session.Mode or "LOBBY"
		payload.Alive = member ~= nil and member.Alive == true
		payload.SpectatorIds = {}
		for _, competitor in ipairs(alivePlayers()) do table.insert(payload.SpectatorIds, competitor.UserId) end
		payload.AliveCount, payload.ReadyCount = #payload.SpectatorIds, #readyPlayers()
		payload.MyChoice = if payload.Mode == "GHOST" then session.GhostChoice else member and member.Choice
		local question = currentRound and currentRound.Question
		if question then
			payload.CharacterId, payload.Choices = question.CharacterId, question.Choices
			payload.ReferenceRGB = if state.Phase == "PREVIEW" then question.OriginalRGB else question.WrongRGB
			if state.Phase == "REVEAL" or state.Phase == "TRAVEL" or state.Phase == "RESULTS" then
				payload.CorrectLane = question.CorrectLane
			end
		end
		payload.Profile = profiles and profiles.public(player)
		payload.Commerce = commerce and commerce.getCatalog(player) or {}
		payload.RoomBoard, payload.GlobalBoards = roomRows(), boards.snapshot()
		payload.LeaderboardStatus = payload.GlobalBoards.Status
		if extra then for key, value in pairs(extra) do payload[key] = value end end
		stateEvent:FireClient(player, payload)
	end
	local function broadcast()
		for _, player in ipairs(Players:GetPlayers()) do personal(player) end
	end
	local function notify(player, message) personal(player, { Toast = message }) end
	local function refreshCosmetics(player)
		local record = profiles.get(player)
		if record and player.Character then
			local ok, message = pcall(Cosmetics.apply, player, record.Data, record.VIP)
			if not ok then warn("Color Chaos cosméticos: " .. tostring(message)) end
		end
	end
	profiles = Profiles.new({ Config = Config, Economy = Economy, Ledger = Ledger, Store = store,
		Enabled = store ~= nil, SessionId = game.JobId .. HttpService:GenerateGUID(false),
		Token = function() return HttpService:GenerateGUID(false) end, IsOnline = online, Notify = notify,
		OnSaved = function(player, data) task.spawn(function() boards.publish(player, data) end) end })
	commerce = Commerce.new({ Config = Config, MarketplaceService = MarketplaceService, Players = Players,
		GetProfile = profiles.get, PersistentGrant = profiles.grantReceipt, Notify = notify,
		Refresh = function(player) refreshCosmetics(player); personal(player) end })
	commerce.start()

	local function freeze(player, value)
		local root = body(player)
		if root then root.Anchored = value; root.AssemblyLinearVelocity = Vector3.zero; root.AssemblyAngularVelocity = Vector3.zero end
	end
	local function teleport(player, position)
		local root = body(player)
		if root and player.Character then
			player.Character:PivotTo(CFrame.new(position))
			root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
		end
	end
	local function stylePart(player, part)
		if not part:IsA("BasePart") then return end
		local ghost = sessions[player] and sessions[player].Mode == "GHOST"
		part.CollisionGroup = ghost and "ColorChaosGhosts" or "ColorChaosPlayers"
		local previous = part:GetAttribute("ColorChaosOriginalTransparency")
		if ghost then
			if previous == nil then part:SetAttribute("ColorChaosOriginalTransparency", part.Transparency) end
			part.Transparency = math.max(part.Transparency, 0.55)
		elseif previous ~= nil then
			part.Transparency = previous
			part:SetAttribute("ColorChaosOriginalTransparency", nil)
		end
	end
	local function setMode(player, mode)
		if not sessions[player] then return end
		sessions[player].Mode = mode
		player:SetAttribute("ColorChaosMode", mode)
		if player.Character then for _, part in ipairs(player.Character:GetDescendants()) do stylePart(player, part) end end
	end
	local function toLobby(player)
		freeze(player, false)
		setMode(player, "LOBBY")
		if sessions[player] then sessions[player].GhostChoice = nil end
		teleport(player, Vector3.new(unpack(Settings.LobbyPosition)))
	end
	local function losePlayer(player, message)
		local member = currentRound and currentRound.Members[player]
		if member and member.Alive then
			member.Alive = false
			local record = profiles.get(player)
			if record then Economy.fail(record.Data); profiles.markDirty(player) end
		end
		toLobby(player)
		if message then notify(player, message) end
	end
	local function enterGhost(player)
		local session, member = sessions[player], currentRound and currentRound.Members[player]
		if not session or not currentRound or state.Phase == "RESULTS" or state.Phase == "LOBBY" then
			notify(player, "La próxima partida comienza en el lobby."); return
		end
		if member and member.Alive then notify(player, "Sigues compitiendo. El modo fantasma es para espectadores."); return end
		local root, humanoid = body(player)
		if not root or not humanoid or humanoid.Health <= 0 then return end
		setMode(player, "GHOST")
		session.GhostChoice = nil
		local coordinates = GameRules.stageCoordinates(state.Stage)
		teleport(player, Vector3.new(0, Settings.AvatarY, coordinates.StartZ))
		freeze(player, state.Phase == "PREVIEW")
		notify(player, "Práctica fantasma: puedes elegir y avanzar, sin sumar puntos ni victorias.")
	end
	local function resetGates()
		for barrier, original in pairs(gatePositions) do
			barrier.CFrame, barrier.CanCollide, barrier.Transparency = original, true, 0.22
		end
	end
	local function openGate(index, lane)
		local barrier = gates[index][lane].Barrier
		barrier.CanCollide = false
		TweenService:Create(barrier, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ CFrame = gatePositions[barrier] + Vector3.new(0, 20, 0), Transparency = 0.68 }):Play()
	end
	local function countdown(phase, seconds, message)
		state.Phase, state.Message = phase, message
		local deadline, displayed = os.clock() + seconds, -1
		repeat
			state.Seconds = math.max(0, math.ceil(deadline - os.clock()))
			if displayed ~= state.Seconds then displayed = state.Seconds; broadcast() end
			task.wait(0.1)
		until closing or os.clock() >= deadline
	end
	local bag = {}
	local function nextCharacter()
		if #bag == 0 then
			for _, character in ipairs(Characters.All) do table.insert(bag, character) end
			for index = #bag, 2, -1 do
				local swap = random:NextInteger(1, index)
				bag[index], bag[swap] = bag[swap], bag[index]
			end
		end
		return table.remove(bag)
	end
	local function processChoice(player)
		local round, session = currentRound, sessions[player]
		if not round or not session or state.Phase ~= "CHOOSE" or round.FinalWinner then return end
		local member = round.Members[player]
		local competing = member and member.Alive
		if not competing and session.Mode ~= "GHOST" then return end
		if (competing and member.Choice) or (not competing and session.GhostChoice) then return end
		local root, humanoid = body(player)
		if not root or not humanoid or humanoid.Health <= 0 then return end
		local chosen = GameRules.validChoice(root.Position, GameRules.stageCoordinates(state.Stage), os.clock() - round.StartedAt, Settings)
		if not chosen then return end
		if competing then
			member.Choice, member.ChoiceAt = chosen, os.clock()
			if state.Final and chosen == round.Question.CorrectLane then round.FinalWinner = player end
		else session.GhostChoice = chosen end
		freeze(player, true)
		personal(player)
	end
	for index, laneGates in ipairs(gates) do
		for _, gate in ipairs(laneGates) do
			gate.ChoicePad.Touched:Connect(function(part)
				if state.Stage ~= index or state.Phase ~= "CHOOSE" then return end
				local model = part:FindFirstAncestorOfClass("Model")
				local player = model and Players:GetPlayerFromCharacter(model)
				if player then processChoice(player) end
			end)
		end
	end
	local function playStage(index)
		local round = currentRound
		state.Stage = index
		state.Final = not round.Solo and ((#alivePlayers() == 2 and index >= Settings.FinalMinStage) or index == Settings.Stages)
		round.Question, round.FinalWinner = GameRules.generateQuestion(nextCharacter(), random), nil
		local coordinates, roster = GameRules.stageCoordinates(index), alivePlayers()
		for slot, player in ipairs(roster) do
			local member = round.Members[player]
			member.Choice, member.ChoiceAt = nil, nil
			Cosmetics.stopEmote(player)
			-- Finalists share one starting point; player collisions are disabled.
			local x = if state.Final then 0 else ((slot - 1) % 5 - 2) * 8
			local z = coordinates.StartZ + (if state.Final then 0 else math.floor((slot - 1) / 5) * 3)
			teleport(player, Vector3.new(x, Settings.AvatarY, z))
			freeze(player, true)
		end
		for player, session in pairs(sessions) do
			if session.Mode == "GHOST" then
				session.GhostChoice = nil
				teleport(player, Vector3.new(0, Settings.AvatarY, coordinates.StartZ))
				freeze(player, true)
			end
		end
		countdown("PREVIEW", Settings.PreviewSeconds, "MEMORIZA · este es el color original")
		if closing then return end
		state.Phase, state.Message = "CHOOSE", state.Final and "FINAL · llega primero a la puerta correcta" or "CORRE · elige un camino y confirma tu respuesta"
		round.StartedAt = os.clock()
		local deadline = round.StartedAt + (state.Final and Settings.FinalSeconds or Settings.RunSeconds)
		for player, session in pairs(sessions) do if session.Mode ~= "LOBBY" then freeze(player, false) end end
		local displayed = -1
		repeat
			local unchosen = 0
			for _, player in ipairs(alivePlayers()) do
				processChoice(player)
				if not round.Members[player].Choice then unchosen += 1 end
			end
			for player, session in pairs(sessions) do if session.Mode == "GHOST" then processChoice(player) end end
			state.Seconds = math.max(0, math.ceil(deadline - os.clock()))
			if displayed ~= state.Seconds then displayed = state.Seconds; broadcast() end
			if round.FinalWinner or unchosen == 0 then break end
			task.wait(0.05)
		until closing or os.clock() >= deadline
		state.Phase = "REVEAL"
		for _, player in ipairs(alivePlayers()) do
			local member, record = round.Members[player], profiles.get(player)
			if member.Choice == round.Question.CorrectLane then
				member.CorrectThisMatch += 1
				member.LastChoiceAt = member.ChoiceAt
				if record then
					local reward = Economy.correct(record.Data, os.time(), Config, record.PendingPaid)
					profiles.markDirty(player)
					notify(player, reward.FreeGifts > 0 and "¡Cinco aciertos seguidos! Tienes un regalo gratis en Regalos." or "¡Correcto! +8 monedas · +10 XP")
				end
				freeze(player, false)
			else losePlayer(player, "Esta vez no acertaste. Puedes observar o practicar como fantasma.") end
		end
		for player, session in pairs(sessions) do
			if session.Mode == "GHOST" then
				freeze(player, false)
				if session.GhostChoice then notify(player, session.GhostChoice == round.Question.CorrectLane
					and "Fantasma: ¡acertaste! Práctica sin puntos." or "Fantasma: prueba de nuevo en el siguiente sector.") end
			end
		end
		openGate(index, round.Question.CorrectLane)
		local survivors = alivePlayers()
		local ending = round.FinalWinner ~= nil or (#survivors == 1 and not round.Solo)
		if ending then for _, player in ipairs(survivors) do freeze(player, true) end end
		countdown("REVEAL", Settings.RevealSeconds, "La puerta " .. round.Question.CorrectLane .. " es la correcta")
		if not ending and #alivePlayers() > 0 then countdown("TRAVEL", Settings.TravelSeconds, "AVANZA · cruza la puerta abierta hacia el siguiente sector") end
	end
	local function runMatch(roster)
		matchCounter += 1
		resetGates()
		currentRound = { Members = {}, Solo = #roster == 1, StartedAt = 0 }
		state.MatchId, state.Solo = matchCounter, currentRound.Solo
		for _, player in ipairs(roster) do
			currentRound.Members[player] = { Alive = true, CorrectThisMatch = 0 }
			setMode(player, "ALIVE")
		end
		local winner
		for index = 1, Settings.Stages do
			if closing then break end
			local survivors = alivePlayers()
			if #survivors == 0 then break end
			if #survivors == 1 and not currentRound.Solo then winner = survivors[1]; break end
			playStage(index)
			if currentRound.FinalWinner then winner = currentRound.FinalWinner; break end
		end
		local survivors = alivePlayers()
		if not winner and not currentRound.Solo and #survivors == 1 then winner = survivors[1] end
		local message = "Ronda terminada · vuelve a intentarlo en la próxima"
		if winner and online(winner) and currentRound.Members[winner].Alive and not closing then
			local record = profiles.get(winner)
			if record then Economy.win(record.Data, os.time(), Config, record.PendingPaid); profiles.markDirty(winner) end
			message = "¡" .. winner.DisplayName .. " gana! +60 monedas · +10 diamantes"
		elseif currentRound.Solo then message = "Práctica terminada · conserva tus premios; las victorias requieren rivales" end
		lastRoom = roomRows()
		for player in pairs(sessions) do toLobby(player) end
		-- Stop eligibility before results; late joins and ghosts never enter this roster.
		for _, member in pairs(currentRound.Members) do member.Alive = false end
		countdown("RESULTS", Settings.ResultSeconds, message)
		currentRound = nil
		state.Stage, state.Final, state.Solo = 0, false, false
	end

	local function limited(player, key, delay)
		local bucket = lastActions[player]
		if not bucket then bucket = {}; lastActions[player] = bucket end
		if bucket[key] and os.clock() - bucket[key] < delay then return true end
		bucket[key] = os.clock()
		return false
	end
	local function validId(value) return type(value) == "string" and #value > 0 and #value <= 80 end
	actionEvent.OnServerEvent:Connect(function(player, action, payload)
		if not online(player) or type(action) ~= "string" or #action > 40 or limited(player, "Any", 0.12) then return end
		if action == "Sync" then if not limited(player, "Sync", 0.5) then personal(player) end; return end
		local record = profiles.get(player)
		if not record or closing then return end
		if action == "EnterGhost" then enterGhost(player); return end
		if action == "LeaveGhost" then
			if sessions[player] and sessions[player].Mode == "GHOST" then toLobby(player); personal(player) end
			return
		end
		if action == "Purchase" then
			if type(payload) == "table" then commerce.requestPurchase(player, payload.Kind, payload.Key) end
			return
		end
		if action == "Emote" or action == "Reaction" then
			local kind = action
			local id = validId(payload) and payload or record.Data.Equipped[kind]
			local item = Catalog.ById[id]
			if not item or item.Kind ~= kind or not (record.Data.CosmeticsOwned[id] or (item.Access == "VIP" and record.VIP)) then return end
			if limited(player, kind, kind == "Emote" and 3 or 2) then return end
			if kind == "Emote" then
				if sessions[player].Mode == "ALIVE" and (state.Phase == "PREVIEW" or state.Phase == "CHOOSE") then
					notify(player, "Los emotes vuelven al terminar la elección."); return
				end
				Cosmetics.playEmote(player, item.Style)
			else Cosmetics.playReaction(player, item.Id) end
			return
		end
		local callback
		if action == "BuyCosmetic" and validId(payload) then
			callback = function(data) return Economy.purchase(data, payload, record.VIP) end
		elseif action == "EquipCosmetic" then
			local id = type(payload) == "table" and payload.Id or payload
			if validId(id) then callback = function(data) return Economy.equip(data, id, record.VIP) end end
		elseif action == "ClaimTimeGift" and validId(payload) then
			callback = function(data) return Economy.claimTimeGift(data, payload, os.time(), Config, record.PendingPaid) end
		elseif action == "OpenGift" and not limited(player, "Gift", 1) then
			local roll, itemRoll, boundary = random:NextInteger(1, 100), 1, 0
			for _, odds in ipairs(Economy.GiftOdds) do
				boundary += odds.Chance
				if roll <= boundary then
					local pool = Catalog.RewardPools[odds.Kind]
					if pool then itemRoll = random:NextInteger(1, #pool) end
					break
				end
			end
			callback = function(data) return Economy.openGift(data, roll, itemRoll, Config, record.PendingPaid) end
		elseif action == "Palette" and type(payload) == "number" and payload == payload and payload % 1 == 0 then
			callback = function(data) return Rules.purchase(data, payload, Config.Palettes, record.VIP) end
		end
		if callback then
			local ok, message, reward = profiles.mutate(player, callback)
			if ok and (action == "BuyCosmetic" or action == "EquipCosmetic" or action == "Palette") then refreshCosmetics(player) end
			personal(player, { Toast = message or (ok and "Listo." or "No se pudo realizar la acción."), GiftResult = reward })
		end
	end)
	local function prompt(name, label, action)
		local anchor = world:FindFirstChild(name)
		if not anchor or not anchor:IsA("BasePart") then return end
		local proximity = Instance.new("ProximityPrompt")
		proximity.Name, proximity.ActionText, proximity.ObjectText = "CiudadPrismaPrompt", label, "Ciudad Prisma"
		proximity.MaxActivationDistance, proximity.HoldDuration, proximity.RequiresLineOfSight = 14, 0, false
		proximity.Parent = anchor
		proximity.Triggered:Connect(function(player)
			if action == "Ghost" then
				if sessions[player] and sessions[player].Mode == "GHOST" then toLobby(player); personal(player) else enterGhost(player) end
			else personal(player, { OpenWindow = action }) end
		end)
	end
	prompt("ShopStand", "Abrir tienda", "Shop")
	prompt("GiftStand", "Ver regalos gratis", "Gifts")
	prompt("GhostPortal", "Practicar como fantasma", "Ghost")
	prompt("GlobalBoard", "Clasificación global", "Leaderboards")
	prompt("RoomBoard", "Clasificación de la sala", "Leaderboards")
	local function updateWorldBoard(name, heading, rows, valueKey, empty)
		local anchor = world:FindFirstChild(name)
		local sign = anchor and anchor:FindFirstChild("StaticSign")
		local panel = sign and sign:FindFirstChild("Panel")
		if not panel then return end
		local title, content = panel:FindFirstChild("Heading"), panel:FindFirstChild("Body")
		if not title or not content then return end
		sign.Size = UDim2.fromScale(34, 22)
		title.Text = heading
		local lines = {}
		for index, row in ipairs(rows) do
			if index > 8 then break end
			table.insert(lines, string.format("%d. %s  ·  %d", index, row.Name or "Jugador", row[valueKey] or 0))
		end
		content.Text = #lines > 0 and table.concat(lines, "\n") or empty
	end
	local function updateBoards()
		local global = boards.snapshot()
		local metric = ({ "Wins", "Streak", "Level" })[math.floor(os.clock() / 10) % 3 + 1]
		local title = ({ Wins = "VICTORIAS", Streak = "MEJOR RACHA", Level = "NIVEL" })[metric]
		updateWorldBoard("GlobalBoard", "GLOBAL · " .. title, global[metric], "Value", global.Status .. "\nAún no hay resultados guardados.")
		updateWorldBoard("RoomBoard", "SALA · ACIERTOS EN ESTA PARTIDA", roomRows(), "CorrectThisMatch", "Tu próxima aventura comienza aquí.")
	end
	local function updatePlayerStats(player)
		local record = profiles.get(player)
		if not record then return end
		local folder = player:FindFirstChild("leaderstats")
		if not folder then folder = Instance.new("Folder"); folder.Name, folder.Parent = "leaderstats", player end
		local values = { Victorias = record.Data.Wins, Racha = record.Data.CurrentStreak,
			Nivel = math.min(1000, math.floor(record.Data.Progress.XP / 100) + 1) }
		for name, value in pairs(values) do
			local stat = folder:FindFirstChild(name)
			if not stat then stat = Instance.new("IntValue"); stat.Name, stat.Parent = name, folder end
			stat.Value = value
		end
	end

	local function characterAdded(player, character)
		local root = character:WaitForChild("HumanoidRootPart", 10)
		local humanoid = character:WaitForChild("Humanoid", 10)
		if not root or not humanoid or not online(player) or player.Character ~= character then return end
		local member = currentRound and currentRound.Members[player]
		if member and member.Alive then losePlayer(player) else toLobby(player) end
		character.DescendantAdded:Connect(function(part) stylePart(player, part) end)
		humanoid.Died:Connect(function()
			if player.Character == character then losePlayer(player, "Regresa al lobby; podrás practicar como fantasma.") end
		end)
		refreshCosmetics(player)
		personal(player)
	end
	local function playerAdded(player)
		if initializing[player] or sessions[player] then return end
		initializing[player], sessions[player] = true, { Mode = "LOBBY" }
		player.RespawnLocation = spawn
		player:SetAttribute("ColorChaosMode", "LOBBY")
		player.CharacterAdded:Connect(function(character) characterAdded(player, character) end)
		if player.Character then task.spawn(characterAdded, player, player.Character) end
		local record = profiles.load(player)
		initializing[player] = nil
		if not record or not online(player) then return end
		refreshCosmetics(player)
		updatePlayerStats(player)
		personal(player, { Toast = currentRound and "La partida ya empezó. Puedes observar o entrar como fantasma." or "Bienvenido. Memoriza el color, elige tu puerta y avanza." })
		task.spawn(function() commerce.refreshPasses(player) end)
	end
	Players.PlayerAdded:Connect(playerAdded)
	Players.PlayerRemoving:Connect(function(player)
		local member = currentRound and currentRound.Members[player]
		if member and member.Alive then
			member.Alive = false
			local record = profiles.get(player)
			if record then Economy.fail(record.Data); profiles.markDirty(player) end
		end
		sessions[player], initializing[player], lastActions[player] = nil, nil, nil
		Cosmetics.cleanup(player)
		profiles.remove(player)
	end)
	for _, player in ipairs(Players:GetPlayers()) do task.spawn(playerAdded, player) end
	game:BindToClose(function() closing = true; profiles.close() end)

	-- A fall can never trap a player in an endless death/void cycle.
	task.spawn(function()
		while not closing do
			for player, session in pairs(sessions) do
				local root, humanoid = body(player)
				if root and humanoid and humanoid.Health > 0 and root.Position.Y < 0 then
					if session.Mode == "ALIVE" then losePlayer(player, "Caíste del recorrido. Puedes seguir como fantasma.")
					elseif session.Mode == "GHOST" and currentRound then
						freeze(player, false)
						teleport(player, Vector3.new(0, Settings.AvatarY, GameRules.stageCoordinates(math.max(1, state.Stage)).StartZ))
					else toLobby(player) end
				end
			end
			task.wait(0.2)
		end
	end)
	task.spawn(function()
		local previous, lastSave, lastBoard = os.clock(), os.clock(), -math.huge
		while not closing do
			task.wait(1)
			local now = os.clock()
			for _, player in ipairs(Players:GetPlayers()) do
				local record = profiles.get(player)
				if record and Economy.advanceTime(record.Data, now - previous, os.time()) > 0 then profiles.markDirty(player) end
				updatePlayerStats(player)
			end
			updateBoards()
			previous = now
			if now - lastSave >= Settings.SaveInterval then
				lastSave = now
				for _, player in ipairs(Players:GetPlayers()) do task.spawn(function() profiles.save(player, false) end) end
			end
			if now - lastBoard >= Settings.LeaderboardInterval then
				lastBoard = now
				task.spawn(function() boards.refresh() end)
			end
		end
	end)
	workspace:SetAttribute("ColorChaosBootStatus", "READY")
	while not closing do
		state.Phase, state.Message, state.Seconds = "LOBBY", "Esperando jugadores en Ciudad Prisma", 0
		while not closing and #readyPlayers() < Settings.MinimumPlayers do broadcast(); task.wait(1) end
		if closing then break end
		countdown("LOBBY", Settings.Intermission, "La próxima expedición comienza pronto · explora el lobby")
		local roster = readyPlayers()
		-- Rotate overflow fairly instead of always taking the lowest user IDs.
		for index = #roster, 2, -1 do local swap = random:NextInteger(1, index); roster[index], roster[swap] = roster[swap], roster[index] end
		while #roster > Settings.MaxParticipants do table.remove(roster) end
		if #roster >= Settings.MinimumPlayers and not closing then
			local ok, problem = xpcall(function() runMatch(roster) end, debug.traceback)
			if not ok then
				warn("Color Chaos ronda: " .. tostring(problem))
				for player in pairs(sessions) do toLobby(player) end
				currentRound = nil
				state.Stage, state.Final, state.Solo = 0, false, false
				countdown("LOBBY", 8, "La ronda se reinició. Tu lobby sigue disponible.")
			end
		end
	end
end

local ok, problem = xpcall(run, debug.traceback)
if not ok then
	workspace:SetAttribute("ColorChaosBootStatus", "ERROR")
	warn("Color Chaos no pudo iniciar. El lobby guardado permanece disponible.\n" .. tostring(problem))
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Profiles</string>
            <string name="Source"><![CDATA[-- Persistence is independent from the world and from Roblox service discovery.
-- A caller must inject a Store acquired safely, or Enabled=false for practice.
-- Player_ keys, numeric receipt values and the legacy Data envelope are retained.
local Profiles = {}

local function copy(value)
	if type(value) ~= "table" then return value end
	local result = {}; for key, child in pairs(value) do result[key] = copy(child) end; return result
end

local function validReceipts(receipts)
	if receipts == nil then return true end
	if type(receipts) ~= "table" then return false end
	for id, amount in pairs(receipts) do
		if type(id) ~= "string" or #id == 0 or #id > 200 or type(amount) ~= "number"
			or amount ~= amount or amount <= 0 or amount == math.huge or amount % 1 ~= 0 then return false end
	end
	return true
end

function Profiles.new(deps)
	assert(type(deps) == "table" and type(deps.Economy) == "table" and type(deps.Ledger) == "table", "Profiles dependencies required")
	local Economy, Ledger, config = deps.Economy, deps.Ledger, deps.Config or {}
	local store, tasks = deps.Store, deps.Tasks or task
	local now, online = deps.Now or os.time, deps.IsOnline or function() return true end
	local clock = deps.Clock or os.clock
	local notify, onSaved = deps.Notify or function() end, deps.OnSaved or function() end
	local warnMessage = deps.Warn or warn
	local session = deps.SessionId or "session-only"
	local enabled = deps.Enabled ~= false and store ~= nil
	local maxCoins, maxReceipts = config.MaxCoins or 100000000, config.MaxReceipts or 10000
	local records, loading, controller = {}, {}, {}
	local closing, sequence = false, 0
	local function token()
		sequence += 1
		return deps.Token and deps.Token() or (session .. ":" .. tostring(now()) .. ":" .. sequence)
	end
	local function clean(raw) return Economy.clean(raw, now(), config) end
	local function envelope(data, release, commit)
		return { Data = data, Session = if release then nil else session,
			LeaseUntil = if release then nil else now() + 240, Commit = commit }
	end
	local function message(player, text) pcall(notify, player, text) end
	local function durable(player, data) pcall(onSaved, player, copy(data)) end
	local function acquire(record)
		while record.Saving do tasks.wait(0.1) end
		return record.Writable == true
	end

	function controller.get(player) return records[player] end

	function controller.load(player)
		if records[player] then return records[player] end
		if closing or loading[player] then return nil end
		loading[player] = true
		local data, writable = clean(nil), false
		if enabled then
			for attempt = 1, 3 do
				local commit = token()
				local ok, saved = pcall(function()
					return store:UpdateAsync("Player_" .. player.UserId, function(old)
						if type(old) == "table" and old.Session and old.Session ~= session and (tonumber(old.LeaseUntil) or 0) > now() then return nil end
						local raw = type(old) == "table" and (old.Data or old) or nil
						-- Never silently remove a receipt with damaged metadata.
						if type(raw) == "table" and not validReceipts(raw.Receipts) then return nil end
						return envelope(clean(raw), false, commit)
					end)
				end)
				if ok and type(saved) == "table" and saved.Session == session and saved.Commit == commit then
					data, writable = clean(saved.Data), true
					break
				end
				if attempt < 3 and online(player) and not closing then tasks.wait(attempt * 2) else break end
			end
		end
		local record = { Data = data, Ready = true, Writable = writable, Saving = false, Leaving = false,
			Revision = 0, SavedRevision = 0, VIP = false, VIPKnown = false, LastSaveFailed = false }
		records[player], loading[player] = record, nil
		if not online(player) or closing then
			record.Leaving = true
			controller.save(player, true)
			records[player] = nil
			return nil
		end
		if enabled and not writable then
			message(player, "No pudimos cargar tu guardado. Puedes jugar gratis; las compras y el guardado están pausados en esta sesión.")
		end
		return record
	end

	function controller.markDirty(player)
		local record = records[player]
		if record then record.Revision += 1 end
	end

	function controller.save(player, release)
		local record = records[player]
		if not record or not record.Writable or not acquire(record) or records[player] ~= record then return false end
		record.Saving = true
		local base, revision, commit = clean(record.Data), record.Revision, token()
		local lostLock = false
		local ok, saved = pcall(function()
			return store:UpdateAsync("Player_" .. player.UserId, function(old)
				lostLock = false
				if type(old) ~= "table" or old.Session ~= session then lostLock = true; return nil end
				if type(old.Data) ~= "table" or not validReceipts(old.Data.Receipts) then return nil end
				local merged = Ledger.merge(base, old.Data, maxCoins)
				return merged and envelope(merged, release, commit) or nil
			end)
		end)
		local reconciled = nil
		if ok and type(saved) == "table" and saved.Commit == commit
			and (release and saved.Session == nil or not release and saved.Session == session) then
			reconciled = Ledger.reconcile(record.Data, saved.Data, maxCoins)
		end
		if reconciled ~= nil then
			if reconciled > 0 then record.Revision += 1 end
			record.PendingPaid, record.UncertainReceipt = nil, nil
			record.LastSaveFailed, record.SavedRevision = false, revision
			if release then record.Writable = false end
		else
			record.LastSaveFailed = true
			if lostLock then record.Writable = false end
			warnMessage("Color Chaos: guardado no confirmado para " .. player.UserId)
			if not record.Leaving then message(player, "Tu guardado está pendiente. Estamos reintentando; las compras están pausadas.") end
		end
		record.Saving = false
		if reconciled ~= nil then durable(player, saved.Data) end
		return reconciled ~= nil
	end

	function controller.grantReceipt(player, receipt, product)
		local record = records[player]
		if not record or not record.Writable or record.Leaving then return false end
		if not acquire(record) or records[player] ~= record or record.Leaving then return false end
		if type(receipt) ~= "table" or type(receipt.PurchaseId) ~= "string" or #receipt.PurchaseId == 0 or #receipt.PurchaseId > 200 then return false end
		if type(product) ~= "table" or type(product.Coins) ~= "number" or product.Coins ~= product.Coins
			or product.Coins <= 0 or product.Coins > maxCoins or product.Coins % 1 ~= 0 then return false end
		if record.UncertainReceipt and record.UncertainReceipt ~= receipt.PurchaseId then return false end
		if record.LastSaveFailed and not record.UncertainReceipt then return false end
		record.Saving, record.PendingPaid = true, product.Coins
		local base, revision, commit = clean(record.Data), record.Revision, token()
		local lostLock = false
		local ok, saved = pcall(function()
			return store:UpdateAsync("Player_" .. player.UserId, function(old)
				lostLock = false
				if type(old) ~= "table" or old.Session ~= session then lostLock = true; return nil end
				if type(old.Data) ~= "table" or not validReceipts(old.Data.Receipts) then return nil end
				local receipts = old.Data.Receipts or {}
				if receipts[receipt.PurchaseId] == nil then
					local count = 0; for _ in pairs(receipts) do count += 1 end
					if count >= maxReceipts then return nil end
				end
				local merged = Ledger.grant(base, old.Data, receipt.PurchaseId, product.Coins, maxCoins)
				return merged and envelope(merged, false, commit) or nil
			end)
		end)
		local recovered = nil
		if ok and type(saved) == "table" and saved.Commit == commit and saved.Session == session
			and type(saved.Data) == "table" and type(saved.Data.Receipts) == "table" and saved.Data.Receipts[receipt.PurchaseId] ~= nil then
			recovered = Ledger.reconcile(record.Data, saved.Data, maxCoins)
		end
		if recovered ~= nil then
			if recovered > 0 then record.Revision += 1 end
			record.LastSaveFailed, record.PendingPaid, record.UncertainReceipt = false, nil, nil
			record.SavedRevision = revision
		else
			record.LastSaveFailed, record.UncertainReceipt = true, receipt.PurchaseId
			if lostLock then record.Writable = false end
		end
		record.Saving = false
		if recovered == nil then
			if tasks.delay then tasks.delay(2, function()
				if records[player] == record and record.Writable and not record.Leaving then controller.save(player, false) end
			end) end
			return false
		end
		durable(player, saved.Data)
		return true, recovered > 0 and ("Compra entregada: +" .. recovered .. " monedas.") or ""
	end

	-- User-triggered purchases/claims use a clone, so failures cannot partly spend
	-- funds. Gameplay rewards may mutate record.Data while persistence yields;
	-- callers then markDirty. Reconciliation only touches Coins and Receipts.
	function controller.mutate(player, callback)
		local record = records[player]
		if not record or record.Leaving or record.Saving then return false, "Espera un momento mientras guardamos." end
		local candidate = clean(record.Data)
		local ok, accepted, text, reward = pcall(callback, candidate)
		if not ok then warnMessage("Color Chaos: cambio de perfil rechazado."); return false, "No se pudo aplicar el cambio." end
		if accepted == false then return false, text end
		record.Data, record.Revision = candidate, record.Revision + 1
		return true, text, reward
	end

	function controller.public(player)
		local record = records[player]
		if not record then return nil end
		local view = Economy.view(record.Data, now())
		view.VIP, view.Persistence = record.VIP == true, record.Writable and (record.LastSaveFailed and "PENDING" or "ACTIVE") or "SESSION"
		return view
	end

	function controller.remove(player)
		local record = records[player]
		if not record then return end
		record.Leaving = true
		controller.save(player, true)
		records[player] = nil
	end

	function controller.close()
		closing = true
		local players, pending = {}, 0
		for player, record in pairs(records) do
			record.Leaving = true
			table.insert(players, player)
		end
		local deadline = clock() + 25
		local launch = tasks.spawn or function(callback) callback() end
		for _, player in ipairs(players) do
			pending += 1
			launch(function()
				local ok = pcall(controller.remove, player)
				if not ok then warnMessage("Color Chaos: no se pudo terminar el guardado al cerrar para " .. player.UserId) end
				pending -= 1
			end)
		end
		-- Roblox allows a short shutdown window: start every player's save before
		-- waiting, including profiles whose load is still acquiring a lease.
		while (pending > 0 or next(loading) ~= nil) and clock() < deadline do tasks.wait(0.1) end
		local finished = pending == 0 and next(loading) == nil
		if not finished then warnMessage("Color Chaos: algunos guardados siguen pendientes al cerrar el servidor.") end
		return finished
	end

	return controller
end

return Profiles
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
    <Item class="Folder" referent="21">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="22">
        <Properties>
          <string name="Name">ColorChaosClient</string>
        </Properties>
        <Item class="LocalScript" referent="23">
          <Properties>
            <string name="Name">Bootstrap</string>
            <bool name="Disabled">true</bool>
            <string name="Source"><![CDATA[-- Independent of shared modules and server initialization. A late server must
-- leave a readable welcome message while the serialized lobby keeps players safe.
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui", 15)
if not playerGui then return end

local gui = Instance.new("ScreenGui")
gui.Name = "ColorChaosWelcome"
gui.ResetOnSpawn = false
gui.DisplayOrder = 100
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = playerGui

local panel = Instance.new("Frame")
panel.AnchorPoint = Vector2.new(0.5, 0)
panel.Position, panel.Size = UDim2.new(0.5, 0, 0, 12), UDim2.new(0.9, 0, 0, 128)
panel.BackgroundColor3 = Color3.fromRGB(19, 29, 56)
panel.BackgroundTransparency = 0.05
panel.Parent = gui
local limit = Instance.new("UISizeConstraint")
limit.MaxSize = Vector2.new(650, 128)
limit.Parent = panel
local corners = Instance.new("UICorner")
corners.CornerRadius = UDim.new(0, 14)
corners.Parent = panel
local border = Instance.new("UIStroke")
border.Color = Color3.fromRGB(102, 232, 204)
border.Thickness = 2
border.Parent = panel

local title = Instance.new("TextLabel")
title.Position, title.Size = UDim2.fromOffset(16, 12), UDim2.new(1, -32, 0, 32)
title.BackgroundTransparency = 1
title.Text = "COLOR CHAOS · CIUDAD PRISMA"
title.TextColor3 = Color3.fromRGB(249, 246, 233)
title.Font, title.TextScaled = Enum.Font.GothamBold, true
title.Parent = panel
local titleLimit = Instance.new("UITextSizeConstraint")
titleLimit.MinTextSize, titleLimit.MaxTextSize = 14, 24
titleLimit.Parent = title

local message = Instance.new("TextLabel")
message.Position, message.Size = UDim2.fromOffset(16, 53), UDim2.new(1, -32, 0, 59)
message.BackgroundTransparency = 1
message.Text = "Estás en el lobby seguro. Preparando la siguiente partida…"
message.TextColor3 = Color3.fromRGB(201, 221, 247)
message.Font, message.TextSize, message.TextWrapped = Enum.Font.Gotham, 16, true
message.Parent = panel

local started = os.clock()
while gui.Parent do
	local mainGui = playerGui:FindFirstChild("ColorChaosUI")
	local status = workspace:GetAttribute("ColorChaosBootStatus")
	-- A snapshot can arrive while server modules are still starting. Both ends
	-- must be ready before dismissing the independent welcome.
	if status == "READY" and mainGui and mainGui:GetAttribute("Ready") == true then
		gui:Destroy()
		break
	end
	if status == "ERROR" then
		message.Text = "La partida no pudo iniciarse. El lobby sigue disponible. Vuelve a entrar para buscar otro servidor."
		border.Color = Color3.fromRGB(255, 145, 169)
	elseif os.clock() - started >= 10 then
		message.Text = "La partida tarda más de lo esperado. Puedes esperar en el lobby seguro."
		border.Color = Color3.fromRGB(255, 188, 97)
	end
	task.wait(0.25)
end
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="24">
          <Properties>
            <string name="Name">Main</string>
            <bool name="Disabled">true</bool>
            <string name="Source"><![CDATA[-- Ciudad Prisma: presentation only. Physical movement selects a door;
-- the server owns answers, gifts, progression and every purchase.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local MarketplaceService = game:GetService("MarketplaceService")
local TweenService = game:GetService("TweenService")
local player = Players.LocalPlayer
local function required(parent, name)
	local child = parent:WaitForChild(name, 20)
	assert(child, "Color Chaos: falta " .. parent.Name .. "." .. name)
	return child
end
local shared = required(ReplicatedStorage, "ColorChaos")
local Config = require(required(shared, "Config"))
local Characters = require(required(shared, "Characters"))
local Portrait = require(required(shared, "Portrait"))
local Catalog = require(required(shared, "Catalog"))
local remotes = required(shared, "Remotes")
local stateEvent, actionEvent = required(remotes, "State"), required(remotes, "Action")
local latest, lastRequests = {}, {}
local currentPage, currentTab, albumPage = nil, nil, 1
local renderPage, showPage, refreshSpectator, redrawWorld, adaptScreen
local spectating, observedId = false, nil
local worldCards, worldSignature, referenceSignature = {}, "", ""
local quoteCache, quotePending, quoteButtons = {}, {}, {}
local toastSerial, renderedProfile = 0, ""
local C = {
	Ink = Color3.fromRGB(19, 29, 56), Panel = Color3.fromRGB(27, 41, 72),
	Card = Color3.fromRGB(37, 54, 86), Muted = Color3.fromRGB(178, 194, 214),
	White = Color3.fromRGB(249, 246, 233), Mint = Color3.fromRGB(102, 232, 204),
	Lilac = Color3.fromRGB(190, 169, 255), Gold = Color3.fromRGB(255, 211, 111),
	Rose = Color3.fromRGB(255, 145, 169), Line = Color3.fromRGB(66, 87, 119),
}
local gui = Instance.new("ScreenGui")
gui.Name, gui.ResetOnSpawn = "ColorChaosUI", false
gui.ZIndexBehavior, gui.DisplayOrder = Enum.ZIndexBehavior.Sibling, 10
gui:SetAttribute("Ready", false)
gui.Parent = player:WaitForChild("PlayerGui")

local function corners(parent, radius)
	local item = Instance.new("UICorner")
	item.CornerRadius, item.Parent = UDim.new(0, radius or 14), parent
end
local function stroke(parent, color, thickness)
	local item = Instance.new("UIStroke")
	item.Color, item.Thickness, item.Transparency = color or C.Line, thickness or 1, 0.25
	item.Parent = parent
	return item
end
local function frame(parent, name, position, size, color)
	local item = Instance.new("Frame")
	item.Name, item.Position, item.Size = name, position, size
	item.BorderSizePixel, item.BackgroundColor3 = 0, color or C.Panel
	item.Parent = parent
	corners(item)
	return item
end
local function label(parent, name, content, position, size, textSize, color)
	local item = Instance.new("TextLabel")
	item.Name, item.Text, item.Position, item.Size = name, content, position, size
	item.BackgroundTransparency, item.TextColor3 = 1, color or C.White
	item.TextSize, item.Font = textSize or 16, Enum.Font.GothamMedium
	item.TextWrapped, item.TextXAlignment = true, Enum.TextXAlignment.Left
	item.Parent = parent
	return item
end
local function fit(item, minimum, maximum)
	item.TextScaled = true
	local limit = Instance.new("UITextSizeConstraint")
	limit.MinTextSize, limit.MaxTextSize = minimum or 11, maximum or item.TextSize
	limit.Parent = item
	return item
end
local function button(parent, name, content, position, size, callback, color)
	local item = Instance.new("TextButton")
	item.Name, item.Text, item.Position, item.Size = name, content, position, size
	item.BorderSizePixel, item.BackgroundColor3 = 0, color or C.Card
	item.TextColor3, item.Font, item.TextSize = C.White, Enum.Font.GothamBold, 14
	item.TextWrapped, item.AutoButtonColor = true, true
	item.Parent = parent
	corners(item, 11)
	item.Activated:Connect(callback)
	return item
end
local function viewport(parent, name, position, size)
	local item = Instance.new("ViewportFrame")
	item.Name, item.Position, item.Size = name, position, size
	item.BackgroundTransparency, item.BorderSizePixel = 1, 0
	item.Parent = parent
	return item
end
local function number(value)
	value = math.max(0, math.floor(tonumber(value) or 0))
	if value >= 1000000 then return string.format("%.1f M", value / 1000000) end
	if value >= 10000 then return string.format("%.1f mil", value / 1000) end
	return tostring(value)
end
local function duration(value)
	value = math.max(0, math.ceil(tonumber(value) or 0))
	return string.format("%d:%02d", math.floor(value / 60), value % 60)
end
local function profile() return type(latest.Profile) == "table" and latest.Profile or {} end
local function send(action, payload, cooldown)
	local now = os.clock()
	if now - (lastRequests[action] or -100) < (cooldown or 0.35) then return end
	lastRequests[action] = now
	actionEvent:FireServer(action, payload)
end
local toast = frame(gui, "Toast", UDim2.new(0.5, 0, 0, 108), UDim2.new(0.86, 0, 0, 56))
toast.AnchorPoint, toast.Visible, toast.ZIndex = Vector2.new(0.5, 0), false, 50
local toastLimit = Instance.new("UISizeConstraint")
toastLimit.MaxSize, toastLimit.Parent = Vector2.new(560, 70), toast
stroke(toast, C.Mint)
local toastText = fit(label(toast, "Message", "", UDim2.fromOffset(15, 8), UDim2.new(1, -30, 1, -16), 16), 12, 16)
local function showToast(message)
	if type(message) ~= "string" or message == "" then return end
	toastSerial += 1
	local serial = toastSerial
	toastText.Text, toast.Visible = message, true
	task.delay(4.5, function() if toastSerial == serial then toast.Visible = false end end)
end

-- Compact HUD keeps the five paths visible and mobile controls accessible.
local hud = frame(gui, "RoundHUD", UDim2.new(0.5, 0, 0, 8), UDim2.new(0.94, 0, 0, 88))
hud.AnchorPoint, hud.BackgroundTransparency = Vector2.new(0.5, 0), 0.04
local hudLimit = Instance.new("UISizeConstraint")
hudLimit.MaxSize, hudLimit.Parent = Vector2.new(820, 88), hud
stroke(hud)
local brand = fit(label(hud, "Brand", "COLOR CHAOS", UDim2.fromOffset(15, 9), UDim2.new(0.43, 0, 0, 23), 20), 12, 20)
brand.Font = Enum.Font.GothamBlack
local phaseLabel = fit(label(hud, "Phase", "CIUDAD PRISMA", UDim2.new(0.43, 0, 0, 9), UDim2.new(0.4, -8, 0, 23), 13, C.Mint), 10, 13)
phaseLabel.TextXAlignment = Enum.TextXAlignment.Right
local timer = label(hud, "Timer", "--", UDim2.new(1, -64, 0, 8), UDim2.fromOffset(49, 26), 24, C.Gold)
timer.TextXAlignment, timer.Font = Enum.TextXAlignment.Right, Enum.Font.GothamBold
local messageLabel = fit(label(hud, "Message", "Bienvenido a Ciudad Prisma", UDim2.fromOffset(15, 36), UDim2.new(1, -30, 0, 23), 15), 11, 15)
local roundLabel = fit(label(hud, "Details", "Explora, recuerda y cruza la puerta correcta", UDim2.fromOffset(15, 63), UDim2.new(1, -30, 0, 17), 12, C.Muted), 10, 12)
local stageBar = frame(hud, "StageProgress", UDim2.new(0, 0, 1, -3), UDim2.new(1, 0, 0, 3), C.Line)
local stageFill = frame(stageBar, "Fill", UDim2.fromScale(0, 0), UDim2.fromScale(0, 1), C.Mint)
local wallet = frame(gui, "Wallet", UDim2.new(0, 14, 1, -60), UDim2.fromOffset(246, 46))
local walletText = fit(label(wallet, "Balances", "0 monedas · 0 diamantes", UDim2.fromOffset(10, 4), UDim2.new(1, -20, 0, 20), 13, C.Gold), 10, 13)
local levelText = fit(label(wallet, "Level", "Nivel 1 · Racha 0", UDim2.fromOffset(10, 25), UDim2.new(1, -20, 0, 16), 11, C.Muted), 9, 11)
local menuButton = button(gui, "Menu", "MENÚ", UDim2.new(0.5, -56, 1, -59), UDim2.fromOffset(112, 44), function()
	showPage(if currentPage then nil else "Inicio")
end, C.Panel)
stroke(menuButton, C.Mint)
local quickButton = button(gui, "QuickEmote", "GESTOS", UDim2.new(0.5, 64, 1, -59), UDim2.fromOffset(92, 44), function() showPage("Armario", "Emote") end)
local spectator = frame(gui, "SpectatorControls", UDim2.new(0.5, 0, 1, -110), UDim2.fromOffset(340, 42))
spectator.AnchorPoint, spectator.Visible = Vector2.new(0.5, 0), false
local ghostButton = button(spectator, "Ghost", "Jugar fantasma", UDim2.fromOffset(4, 4), UDim2.fromOffset(136, 34), function()
	send(if latest.Mode == "GHOST" then "LeaveGhost" else "EnterGhost")
	spectating = false
	refreshSpectator()
end)
local observeButton = button(spectator, "Observe", "Observar", UDim2.fromOffset(145, 4), UDim2.fromOffset(121, 34), function()
	spectating = not spectating
	refreshSpectator()
end)
local nextObserved = button(spectator, "NextObserved", ">", UDim2.fromOffset(271, 4), UDim2.fromOffset(65, 34), function()
	local ids = latest.SpectatorIds or {}
	local index = table.find(ids, observedId) or 0
	observedId = ids[(index % math.max(1, #ids)) + 1]
	spectating = true
	refreshSpectator()
end)
